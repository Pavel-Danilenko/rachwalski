{
   "extends": "astro/tsconfigs/strict",
   "compilerOptions": {
      "baseUrl": ".",
      "ignoreDeprecations": "6.0",
      "types": ["vite/client"],
      "paths": {
         "@/*": ["src/*"],
         "@components/*": ["src/components/*"],
         "@layouts/*": ["src/layouts/*"],
         "@scripts/*": ["src/scripts/*"],
         "@styles/*": ["src/styles/*"],
         "@utils/*": ["src/utils/*"],
         "@assets/*": ["src/assets/*"],
         "@data/*": ["src/data/*"],
         "@i18n/*": ["src/i18n/*"],
         "@config/*": ["src/config/*"]
      }
   },
   "include": [".astro/types.d.ts", "**/*"],
   "exclude": ["dist"]
}
