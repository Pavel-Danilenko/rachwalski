         "<NavItem nav=\"${1:services}\" as=\"button\" data-menu-dropdown-toggle />",
         "$0",
      ],
   },

   // ─── nav.ts — новий запис ─────────────────────────────────────────────────
   "Nav config entry": {
      "prefix": "fnavcfg",
      "scope": "typescript",
      "description": "Новий запис у nav.ts",
      "body": [
         "${1:key}: {",
         "\tlabel: \"${2:Назва}\",",
         "\turl: \"${3:/page}\",",
         "},",
      ],
   },

   // ─── MenuCustom — просте меню ─────────────────────────────────────────────
   "MenuCustom simple": {
      "prefix": "fmenu",
      "scope": "astro,html",
      "description": "MenuCustom з простим списком NavItem",
      "body": [
         "---",
         "import MenuCustom from \"@components/menu/MenuCustom.astro\";",
         "import NavItem    from \"@components/menu/NavItem.astro\";",
         "---",
         "",
         "<MenuCustom>",
         "\t<div data-menu-overlay class=\"${1:header__nav}\">",
         "\t\t<ul class=\"${2:header__nav-list}\">",
         "\t\t\t<li><NavItem nav=\"home\"    class=\"${3:header__nav-link}\" /></li>",
         "\t\t\t<li><NavItem nav=\"about\"   class=\"${3:header__nav-link}\" /></li>",
         "\t\t\t<li><NavItem nav=\"contact\" class=\"${3:header__nav-link}\" /></li>",
         "\t\t</ul>",
         "\t</div>",
         "</MenuCustom>",
         "$0",
      ],
   },

   // ─── MenuCustom — з dropdown ──────────────────────────────────────────────
   "MenuCustom dropdown": {
      "prefix": "fmenu:dropdown",
      "scope": "astro,html",
      "description": "MenuCustom з одним dropdown пунктом",
      "body": [
         "<MenuCustom>",
         "\t<div data-menu-overlay>",
         "\t\t<ul>",
         "\t\t\t<li><NavItem nav=\"home\" /></li>",
         "",
         "\t\t\t<li data-submenu-open=\"${1:services}\">",
         "\t\t\t\t<NavItem nav=\"${1:services}\" as=\"button\" data-menu-dropdown-toggle />",
         "\t\t\t\t<ul data-submenu=\"${1:services}\">",
         "\t\t\t\t\t<li><NavItem nav=\"${2:servicesWeb}\" /></li>",
         "\t\t\t\t\t<li><NavItem nav=\"${3:servicesDesign}\" /></li>",
         "\t\t\t\t</ul>",
         "\t\t\t</li>",
         "\t\t</ul>",
         "\t</div>",
         "</MenuCustom>",
         "$0",
      ],
   },

   // ─── Sitemap — базовий ────────────────────────────────────────────────────
   "Sitemap base": {
      "prefix": "fsitemap",
      "scope": "astro,html",
      "description": "Sitemap з групами — колонки на десктопі, accordion на мобільному",
      "body": [
         "---",
         "import Sitemap      from \"@components/sitemap/Sitemap.astro\";",
         "import SitemapGroup from \"@components/sitemap/SitemapGroup.astro\";",
         "import NavItem      from \"@components/menu/NavItem.astro\";",
         "---",
         "",
         "<Sitemap breakpoint={${1:768}}>",
         "",
         "\t<SitemapGroup title=\"${2:Сторінки}\" open>",
         "\t\t<NavItem nav=\"home\" />",
         "\t\t<NavItem nav=\"about\" />",
         "\t</SitemapGroup>",
         "",
         "\t<SitemapGroup title=\"${3:Послуги}\">",
         "\t\t<NavItem nav=\"${4:servicesWeb}\" />",
         "\t\t<NavItem nav=\"${5:servicesDesign}\" />",
         "\t</SitemapGroup>",
         "",
         "\t<SitemapGroup title=\"${6:Контакти}\">",
         "\t\t<NavItem nav=\"contact\" />",
         "\t</SitemapGroup>",
         "",
         "</Sitemap>",
         "$0",
      ],
   },

   // ─── SitemapGroup — одна група ────────────────────────────────────────────
   "SitemapGroup": {
      "prefix": "fsitemap:group",
      "scope": "astro,html",
      "description": "Одна SitemapGroup з NavItem посиланнями",
      "body": [
         "<SitemapGroup title=\"${1:Назва групи}\">",
         "\t<NavItem nav=\"${2:home}\" />",
         "\t<NavItem nav=\"${3:about}\" />",
         "\t$0",
         "</SitemapGroup>",
      ],
   },

   // ─── Img — базовий ───────────────────────────────────────────────────────
   "Img base": {
      "prefix": "fimg",
      "scope": "astro,html",
      "description": "Img — оптимізоване зображення з astro:assets",
      "body": [
         "---",
         "import Img from \"@components/media/Img.astro\";",
         "import ${1:imgName} from \"@assets/img/${2:image.jpg}\";",
         "---",
         "",
         "<Img",
         "\tsrc={${1:imgName}}",
         "\talt=\"${3:Опис зображення}\"",
         "\twidth={${4:800}}",
         "\theight={${5:600}}",
         "/>",
         "$0",
      ],
   },

   // ─── Img — hero / LCP ────────────────────────────────────────────────────
   "Img hero": {
      "prefix": "fimg:hero",
      "scope": "astro,html",
      "description": "Img для hero / LCP зображення (перший екран)",
      "body": [
         "<Img",
         "\tsrc={${1:heroImg}}",
         "\talt=\"${2:Hero}\"",
         "\twidth={${3:1920}}",
         "\theight={${4:1080}}",
         "\tloading=\"eager\"",
         "\tfetchpriority=\"high\"",
         "\tdecoding=\"sync\"",
         "\tquality={${5:90}}",
         "\tsizes=\"100vw\"",
         "\twidths={[768, 1280, 1920]}",
         "/>",
         "$0",
      ],
   },

   // ─── Img — з класами ─────────────────────────────────────────────────────
   "Img with classes": {
      "prefix": "fimg:class",
      "scope": "astro,html",
      "description": "Img з кастомними класами на img і wrapper",
      "body": [
         "<Img",
         "\tsrc={${1:img}}",
         "\talt=\"${2:Опис}\"",
         "\twidth={${3:800}}",
         "\theight={${4:600}}",
         "\tclass=\"${5:my-img}\"",
         "\twrapperClass=\"${6:my-img-wrapper}\"",
         "/>",
         "$0",
      ],
   },

   // ─── Img — contain (логотип, іконка) ─────────────────────────────────────
   "Img contain": {
      "prefix": "fimg:contain",
      "scope": "astro,html",
      "description": "Img з object-fit contain (логотип, іконка)",
      "body": [
         "<Img",
         "\tsrc={${1:logoImg}}",
         "\talt=\"${2:Логотип}\"",
         "\twidth={${3:200}}",
         "\theight={${4:80}}",
         "\tobjectFit=\"contain\"",
         "/>",
         "$0",
      ],
   },

   // ─── ResponsiveImg — базовий ─────────────────────────────────────────────
   "ResponsiveImg base": {
      "prefix": "frimg",
      "scope": "astro,html",
      "description": "ResponsiveImg — різні зображення для desktop і mobile (< 768px)",
      "body": [
         "---",
         "import ResponsiveImg from \"@components/media/ResponsiveImg.astro\";",
         "import ${1:imgDesktop} from \"@assets/img/${2:image-desktop.jpg}\";",
         "import ${3:imgMobile} from \"@assets/img/${4:image-mobile.jpg}\";",
         "---",
         "",
         "<ResponsiveImg",
         "\tsrcDesktop={${1:imgDesktop}}",
         "\tsrcMobile={${3:imgMobile}}",
         "\talt=\"${5:Опис зображення}\"",
         "/>",
         "$0",
      ],
   },

   // ─── ResponsiveImg — hero / LCP ──────────────────────────────────────────
   "ResponsiveImg hero": {
      "prefix": "frimg:hero",
      "scope": "astro,html",
      "description": "ResponsiveImg для hero / LCP — eager + fetchpriority",
      "body": [
         "<ResponsiveImg",
         "\tsrcDesktop={${1:heroDesktop}}",
         "\tsrcMobile={${2:heroMobile}}",
         "\talt=\"${3:Hero}\"",
         "\tloading=\"eager\"",
         "\tfetchpriority=\"high\"",
         "\tdecoding=\"sync\"",
         "\tquality={${4:90}}",
         "\twrapperClass=\"${5:hero__bg}\"",
         "/>",
         "$0",
      ],
   },

   // ─── ResponsiveImg — з кастомним брейкпоінтом ────────────────────────────
   "ResponsiveImg breakpoint": {
      "prefix": "frimg:bp",
      "scope": "astro,html",
      "description": "ResponsiveImg з кастомним брейкпоінтом",
      "body": [
         "<ResponsiveImg",
         "\tsrcDesktop={${1:imgDesktop}}",
         "\tsrcMobile={${2:imgMobile}}",
         "\talt=\"${3:Опис}\"",
         "\tbreakpoint={${4|768,1024,992,480|}}",
         "\twrapperClass=\"${5:wrapper}\"",
         "/>",
         "$0",
      ],
   },
}
