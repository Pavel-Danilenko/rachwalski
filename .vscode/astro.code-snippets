{
   // ─── Gallery — підключення ────────────────────────────────────────────────
   "Gallery base": {
      "prefix": "fgallery",
      "scope": "astro,html",
      "description": "Gallery з Fancybox lightbox (Content Collections)",
      "body": [
         "---",
         "import Gallery from \"@components/media/gallery.astro\";",
         "---",
         "",
         "<div class=\"${1:gallery-section}\">",
         "\t<Gallery",
         "\t\tcollectionName=\"${2:gallery}\"",
         "\t\tshowHover={${3|true,false|}}",
         "\t\tshowTitle={${4|true,false|}}",
         "\t\tshowDesc={${5|true,false|}}",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── Gallery — markdown item ──────────────────────────────────────────────
   "Gallery item": {
      "prefix": "fgallery:item",
      "scope": "markdown",
      "description": "Елемент колекції галереї (markdown frontmatter)",
      "body": [
         "---",
         "title: \"${1:Назва фото}\"",
         "shortDesc: \"${2:Короткий опис}\"",
         "fullCaption: \"${3:Підпис у lightbox}\"",
         "thumb: ./images/${4:photo.jpg}",
         "order: ${5:1}",
         "---",
         "$0",
      ],
   },

   // ─── Logo — базовий (хедер) ──────────────────────────────────────────────
   "Logo base": {
      "prefix": "flogo",
      "scope": "astro,html",
      "description": "Logo — текстовий логотип для хедера",
      "body": [
         "---",
         "import Logo from \"@components/ui/Logo.astro\";",
         "---",
         "",
         "<Logo href=\"/\" text=\"${1:My Logo}\" />",
         "$0",
      ],
   },

   // ─── Logo — із зображенням ────────────────────────────────────────────────
   "Logo image": {
      "prefix": "flogo:img",
      "scope": "astro,html",
      "description": "Logo із зображенням",
      "body": [
         "<Logo href=\"/\" imageSrc=\"${1:/logo.svg}\" imageAlt=\"${2:My Company}\" />",
         "$0",
      ],
   },

   // ─── Logo — футер ─────────────────────────────────────────────────────────
   "Logo footer": {
      "prefix": "flogo:footer",
      "scope": "astro,html",
      "description": "Logo для футера — завжди посилання",
      "body": [
         "<Logo href=\"/\" text=\"${1:My Logo}\" alwaysLink class=\"${2:footer__logo}\" />",
         "$0",
      ],
   },

   // ─── Icon — базовий ───────────────────────────────────────────────────────
   "Icon base": {
      "prefix": "ficon",
      "scope": "astro,html",
      "description": "Icon — SVG іконка зі спрайту",
      "body": ["<Icon name=\"${1:close}\" />"],
   },

   // ─── Icon — з розміром ────────────────────────────────────────────────────
   "Icon with size": {
      "prefix": "ficon:size",
      "scope": "astro,html",
      "description": "Icon з явним розміром",
      "body": ["<Icon name=\"${1:close}\" size={${2:24}} />"],
   },

   // ─── Icon — з кольором ────────────────────────────────────────────────────
   "Icon with color": {
      "prefix": "ficon:color",
      "scope": "astro,html",
      "description": "Icon з кольором через CSS-змінну",
      "body": [
         "<Icon name=\"${1:close}\" color=\"${2:var(--color-primary)}\" />",
      ],
   },

   // ─── Icon — повний ────────────────────────────────────────────────────────
   "Icon full": {
      "prefix": "ficon:full",
      "scope": "astro,html",
      "description": "Icon з усіма пропсами",
      "body": [
         "<Icon",
         "\tname=\"${1:close}\"",
         "\tsize={${2:20}}",
         "\tcolor=\"${3:currentColor}\"",
         "\tclass=\"${4:my-icon}\"",
         "/>",
      ],
   },

   // ─── ContactForm — базова структура ──────────────────────────────────────
   "ContactForm base": {
      "prefix": "cform",
      "scope": "astro,html",
      "description": "ContactForm з базовими полями: ім'я, email, телефон, селект, textarea",
      "body": [
         "---",
         "import ContactForm from \"@components/forms/ContactForm.astro\";",
         "import CustomSelect from \"@components/forms/CustomSelect.astro\";",
         "import CustomPhoneInput from \"@components/forms/CustomPhoneInput.astro\";",
         "---",
         "",
         "<ContactForm",
         "\tbackend=\"${1|api,php|}\"",
         "\tformKey=\"${2:contact}\"",
         "\tsuccessMessage=\"${3:Дякуємо! Ми зв'яжемося з вами найближчим часом.}\"",
         "\terrorMessage=\"${4:Помилка відправки. Спробуйте ще раз.}\"",
         "\tmodalType=\"${5|inline,modal|}\"",
         ">",
         "\t<div class=\"${6:form-fields}\">",
         "",
         "\t\t<div class=\"form-group\">",
         "\t\t\t<input",
         "\t\t\t\ttype=\"text\"",
         "\t\t\t\tname=\"name\"",
         "\t\t\t\tplaceholder=\"Ваше ім'я\"",
         "\t\t\t\trequired",
         "\t\t\t\tdata-error-required=\"Введіть ваше ім'я\"",
         "\t\t\t\tdata-min-length=\"2\"",
         "\t\t\t\tdata-error-min-length=\"Ім'я занадто коротке\"",
         "\t\t\t/>",
         "\t\t</div>",
         "",
         "\t\t<div class=\"form-group\">",
         "\t\t\t<input",
         "\t\t\t\ttype=\"email\"",
         "\t\t\t\tname=\"email\"",
         "\t\t\t\tplaceholder=\"email@example.com\"",
         "\t\t\t\trequired",
         "\t\t\t\tdata-error-required=\"Введіть email\"",
         "\t\t\t\tdata-error-email=\"Невірний формат email\"",
         "\t\t\t\tdata-hint-corrected=\"Виправлено на {domain}\"",
         "\t\t\t/>",
         "\t\t</div>",
         "",
         "\t\t<div class=\"form-group\">",
         "\t\t\t<CustomPhoneInput",
         "\t\t\t\tname=\"phone\"",
         "\t\t\t\tdefaultCountry=\"UA\"",
         "\t\t\t\trequired",
         "\t\t\t\tsearchable",
         "\t\t\t\tsearchPlaceholder=\"Пошук країни...\"",
         "\t\t\t\tnoResultsText=\"Нічого не знайдено\"",
         "\t\t\t\terrorRequired=\"Введіть номер телефону\"",
         "\t\t\t\terrorPhone=\"Невірний формат телефону\"",
         "\t\t\t/>",
         "\t\t</div>",
         "",
         "\t\t<div class=\"form-group\">",
         "\t\t\t<CustomSelect",
         "\t\t\t\tname=\"${7:service}\"",
         "\t\t\t\tplaceholder=\"${8:Оберіть варіант}\"",
         "\t\t\t\trequired",
         "\t\t\t\terrorRequired=\"${9:Оберіть варіант}\"",
         "\t\t\t\toptions={[",
         "\t\t\t\t\t{ value: \"${10:option1}\", label: \"${11:Варіант 1}\" },",
         "\t\t\t\t\t{ value: \"${12:option2}\", label: \"${13:Варіант 2}\" },",
         "\t\t\t\t]}",
         "\t\t\t/>",
         "\t\t</div>",
         "",
         "\t\t<div class=\"form-group\">",
         "\t\t\t<textarea",
         "\t\t\t\tname=\"message\"",
         "\t\t\t\tplaceholder=\"Ваше повідомлення\"",
         "\t\t\t\trows=\"4\"",
         "\t\t\t\trequired",
         "\t\t\t\tdata-error-required=\"Напишіть повідомлення\"",
         "\t\t\t\tdata-min-words=\"3\"",
         "\t\t\t\tdata-error-min-words=\"Мінімум 3 слова\"",
         "\t\t\t\tdata-error-spam=\"Схоже на спам\"",
         "\t\t\t></textarea>",
         "\t\t</div>",
         "",
         "\t\t<button type=\"submit\">${14:Надіслати}</button>",
         "",
         "\t</div>",
         "</ContactForm>",
         "$0",
      ],
   },

   // ─── CustomSelect — базовий ──────────────────────────────────────────────
   "CustomSelect": {
      "prefix": "fselect",
      "scope": "astro,html",
      "description": "CustomSelect — кастомний селект з пошуком і валідацією",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomSelect",
         "\t\tname=\"${1:field}\"",
         "\t\tplaceholder=\"${2:Оберіть варіант}\"",
         "\t\t${3|searchable,|}",
         "\t\t${4:required}",
         "\t\terrorRequired=\"${5:Оберіть варіант}\"",
         "\t\toptions={[",
         "\t\t\t{ value: \"${6:option1}\", label: \"${7:Варіант 1}\" },",
         "\t\t\t{ value: \"${8:option2}\", label: \"${9:Варіант 2}\" },",
         "\t\t\t{ value: \"${10:option3}\", label: \"${11:Варіант 3}\" },",
         "\t\t]}",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomSelect — multiple ──────────────────────────────────────────────
   "CustomSelectMultiple": {
      "prefix": "fselectmulti",
      "scope": "astro,html",
      "description": "CustomSelect з множинним вибором, тегами і select all",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomSelect",
         "\t\tname=\"${1:field}\"",
         "\t\tplaceholder=\"${2:Оберіть варіанти}\"",
         "\t\tmultiple",
         "\t\tshowRemovableTags",
         "\t\tshowSelectAll",
         "\t\tselectAllText=\"${3:Вибрати всі}\"",
         "\t\tdeselectAllText=\"${4:Скасувати}\"",
         "\t\t${5|searchable,|}",
         "\t\tsearchPlaceholder=\"${6:Пошук...}\"",
         "\t\tnoResultsText=\"${7:Нічого не знайдено}\"",
         "\t\toptions={[",
         "\t\t\t{ value: \"${8:option1}\", label: \"${9:Варіант 1}\" },",
         "\t\t\t{ value: \"${10:option2}\", label: \"${11:Варіант 2}\" },",
         "\t\t]}",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomSelect — з групами ─────────────────────────────────────────────
   "CustomSelectGroup": {
      "prefix": "fselectgroup",
      "scope": "astro,html",
      "description": "CustomSelect з групами опцій",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomSelect",
         "\t\tname=\"${1:field}\"",
         "\t\tplaceholder=\"${2:Оберіть варіант}\"",
         "\t\toptions={[",
         "\t\t\t{",
         "\t\t\t\tgroup: \"${3:Група 1}\",",
         "\t\t\t\titems: [",
         "\t\t\t\t\t{ value: \"${4:opt1}\", label: \"${5:Варіант 1}\" },",
         "\t\t\t\t\t{ value: \"${6:opt2}\", label: \"${7:Варіант 2}\" },",
         "\t\t\t\t],",
         "\t\t\t},",
         "\t\t\t{",
         "\t\t\t\tgroup: \"${8:Група 2}\",",
         "\t\t\t\titems: [",
         "\t\t\t\t\t{ value: \"${9:opt3}\", label: \"${10:Варіант 3}\" },",
         "\t\t\t\t\t{ value: \"${11:opt4}\", label: \"${12:Варіант 4}\" },",
         "\t\t\t\t],",
         "\t\t\t},",
         "\t\t]}",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomPhoneInput — кастомне поле телефону з вибором країни ─────────
   "CustomPhoneInput": {
      "prefix": "fphone",
      "scope": "astro,html",
      "description": "CustomPhoneInput — поле телефону з дропдауном країн, пошуком і форматуванням",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomPhoneInput",
         "\t\tname=\"${1:phone}\"",
         "\t\tdefaultCountry=\"${2:UA}\"",
         "\t\tplaceholder=\"${3:XX XXX XX XX}\"",
         "\t\trequired",
         "\t\t${4|searchable,|}",
         "\t\tsearchPlaceholder=\"${5:Пошук країни...}\"",
         "\t\tnoResultsText=\"${6:Нічого не знайдено}\"",
         "\t\terrorRequired=\"${7:Введіть номер телефону}\"",
         "\t\terrorPhone=\"${8:Невірний формат телефону}\"",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── Simple phone — простий input з data-phone ────────────────────────────
   "Simple phone input": {
      "prefix": "fphonesi",
      "scope": "astro,html",
      "description": "Простий input[type=tel] з data-phone автоформатуванням",
      "body": [
         "<div class=\"form-group\">",
         "\t<input",
         "\t\ttype=\"tel\"",
         "\t\tname=\"${1:phone}\"",
         "\t\tplaceholder=\"+380\"",
         "\t\trequired",
         "\t\tdata-phone",
         "\t\tdata-error-required=\"${2:Введіть номер телефону}\"",
         "\t\tdata-error-phone=\"${3:Невірний формат телефону}\"",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomPasswordInput ─────────────────────────────────────────────────
   "CustomPasswordInput": {
      "prefix": "fpassword",
      "scope": "astro,html",
      "description": "CustomPasswordInput — поле пароля з інтерактивним оком (cursor tracking), strength meter і checklist вимог",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomPasswordInput",
         "\t\tname=\"${1:password}\"",
         "\t\tplaceholder=\"${2:Пароль}\"",
         "\t\trequired",
         "\t\t${3|showStrength,|}",
         "\t\t${4|showRequirements,|}",
         "\t\tminLength={${5:8}}",
         "\t\t${6|requireUppercase,|}",
         "\t\t${7|requireNumbers,|}",
         "\t\t${8|requireSpecial,|}",
         "\t\ttoggleLabel=\"${9:Показати/сховати пароль}\"",
         "\t\tcapsLockText=\"${10:Caps Lock увімкнено}\"",
         "\t\tstrengthWeak=\"${11:Слабкий}\"",
         "\t\tstrengthMedium=\"${12:Середній}\"",
         "\t\tstrengthStrong=\"${13:Сильний}\"",
         "\t\trequirementTexts={{",
         "\t\t\tlength: \"${14:Мінімум} ${5:8} ${15:символів}\",",
         "\t\t\tuppercase: \"${16:Велика літера}\",",
         "\t\t\tnumbers: \"${17:Цифра}\",",
         "\t\t\tspecial: \"${18:Спецсимвол}\",",
         "\t\t}}",
         "\t\terrorRequired=\"${19:Введіть пароль}\"",
         "\t\terrorMinLength=\"${20:Пароль занадто короткий}\"",
         "\t\terrorWeak=\"${21:Пароль занадто слабкий}\"",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomFileInput — базовий ───────────────────────────────────────────
   "CustomFileInput": {
      "prefix": "ffile",
      "scope": "astro,html",
      "description": "CustomFileInput — поле завантаження файлу з drag & drop",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomFileInput",
         "\t\tname=\"${1:file}\"",
         "\t\taccept=\"${2:.jpg,.jpeg,.png,.pdf}\"",
         "\t\tmaxSize={${3:5}}",
         "\t\tbuttonText=\"${4:Додати файл}\"",
         "\t\tdragText=\"${5:або перетягніть сюди}\"",
         "\t\t${6:required}",
         "\t\terrorRequired=\"${7:Додайте файл}\"",
         "\t\terrorFileSize=\"${8:Файл перевищує ліміт}\"",
         "\t\terrorFileType=\"${9:Непідтримуваний формат}\"",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomFileInput — multiple ───────────────────────────────────────────
   "CustomFileInputMultiple": {
      "prefix": "ffilemulti",
      "scope": "astro,html",
      "description": "CustomFileInput — кілька файлів з лімітом і accordion",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomFileInput",
         "\t\tname=\"${1:files}\"",
         "\t\tmultiple",
         "\t\taccept=\"${2:.jpg,.jpeg,.png,.pdf,.doc,.docx}\"",
         "\t\tmaxSize={${3:10}}",
         "\t\tmaxFiles={${4:5}}",
         "\t\tbuttonText=\"${5:Додати файли}\"",
         "\t\tdragText=\"${6:або перетягніть сюди}\"",
         "\t\tremoveAllText=\"${7:Видалити всі}\"",
         "\t\tfileListButtonText=\"${8:Файли ({count})}\"",
         "\t\temptyStateText=\"${9:Файлів немає}\"",
         "\t\terrorFileSize=\"${10:Файл більше ліміту}\"",
         "\t\terrorFileType=\"${11:Непідтримуваний формат}\"",
         "\t\terrorMaxFiles=\"${12:Забагато файлів}\"",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomDatePicker — базовий ──────────────────────────────────────────
   "CustomDatePicker": {
      "prefix": "fdatepicker",
      "scope": "astro,html",
      "description": "CustomDatePicker з українською локалізацією і анімацією слайду",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomDatePicker",
         "\t\tname=\"${1:date}\"",
         "\t\tplaceholder=\"${2:Оберіть дату}\"",
         "\t\tformat=\"DD.MM.YYYY\"",
         "\t\tfirstDayOfWeek={1}",
         "\t\tmonthNames={[\"Січень\",\"Лютий\",\"Березень\",\"Квітень\",\"Травень\",\"Червень\",\"Липень\",\"Серпень\",\"Вересень\",\"Жовтень\",\"Листопад\",\"Грудень\"]}",
         "\t\tdayNamesMin={[\"Нд\",\"Пн\",\"Вт\",\"Ср\",\"Чт\",\"Пт\",\"Сб\"]}",
         "\t\ttodayText=\"Сьогодні\"",
         "\t\tclearText=\"Очистити\"",
         "\t\ttransition=\"${3|slide,fade,scale,none|}\"",
         "\t\t${4:required}",
         "\t\tdata-error-required=\"${5:Оберіть дату}\"",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomDatePicker — range ─────────────────────────────────────────────
   "CustomDatePickerRange": {
      "prefix": "fdatepickerrange",
      "scope": "astro,html",
      "description": "CustomDatePicker в режимі range (діапазон дат)",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomDatePicker",
         "\t\tname=\"${1:dateRange}\"",
         "\t\tmode=\"range\"",
         "\t\tplaceholder=\"${2:Початок — Кінець}\"",
         "\t\tformat=\"DD.MM.YYYY\"",
         "\t\tfirstDayOfWeek={1}",
         "\t\tmonthNames={[\"Січень\",\"Лютий\",\"Березень\",\"Квітень\",\"Травень\",\"Червень\",\"Липень\",\"Серпень\",\"Вересень\",\"Жовтень\",\"Листопад\",\"Грудень\"]}",
         "\t\tdayNamesMin={[\"Нд\",\"Пн\",\"Вт\",\"Ср\",\"Чт\",\"Пт\",\"Сб\"]}",
         "\t\tapplyText=\"Застосувати\"",
         "\t\tcancelText=\"Скасувати\"",
         "\t\ttodayText=\"Сьогодні\"",
         "\t\tclearText=\"Очистити\"",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── CustomRangeInput ─────────────────────────────────────────────────────
   "CustomRangeInput": {
      "prefix": "frange",
      "scope": "astro,html",
      "description": "CustomRangeInput — слайдер з fill і відображенням значення",
      "body": [
         "<div class=\"form-group\">",
         "\t<CustomRangeInput",
         "\t\tname=\"${1:range}\"",
         "\t\tmin={${2:0}}",
         "\t\tmax={${3:100}}",
         "\t\tstep={${4:1}}",
         "\t\tvalue={${5:50}}",
         "\t\tunit=\"${6:%}\"",
         "\t\t${7|showMinMax,|}",
         "\t/>",
         "</div>",
         "$0",
      ],
   },

   // ─── FormWizard ───────────────────────────────────────────────────────────
   "FormWizard": {
      "prefix": "fwizard",
      "scope": "astro,html",
      "description": "FormWizard — 3-кроковий wizard з ProgressStepper, анімацією слайду і підсумком",
      "body": [
         "---",
         "import ProgressStepper from \"@components/progress-bar/ProgressStepper.astro\";",
         "import ContactForm from \"@components/forms/ContactForm.astro\";",
         "import \"@styles/components/forms/_form-wizard.scss\";",
         "---",
         "",
         "<ProgressStepper",
         "\tid=\"${1:wizard}\"",
         "\tsteps={[",
         "\t\t{ label: \"${2:Крок 1}\" },",
         "\t\t{ label: \"${3:Крок 2}\" },",
         "\t\t{ label: \"${4:Підтвердження}\" },",
         "\t]}",
         "\tcurrentStep={1}",
         "/>",
         "",
         "<ContactForm",
         "\tformId=\"${5:wizard-form}\"",
         "\twizardId=\"${1:wizard}\"",
         "\tbackend=\"${6|api,php|}\"",
         "\tformKey=\"${7:contact}\"",
         "\tsuccessMessage=\"${8:Форму надіслано!}\"",
         "\tdata-wizard-transition=\"${9|slide,morph|}\"",
         "\tdata-wizard-autofocus",
         "\tdata-wizard-shake",
         ">",
         "\t<div class=\"wizard-steps-wrapper\">",
         "\t\t<!-- Крок 1 -->",
         "\t\t<div data-wizard-step=\"1\" data-wizard-label=\"${2:Крок 1}\">",
         "\t\t\t<div class=\"form-group\">",
         "\t\t\t\t<input type=\"text\" name=\"name\" placeholder=\"${10:Ім'я}\"",
         "\t\t\t\t\tdata-wizard-field=\"${10:Ім'я}\"",
         "\t\t\t\t\trequired data-error-required=\"${11:Введіть ім'я}\" />",
         "\t\t\t</div>",
         "\t\t</div>",
         "",
         "\t\t<!-- Крок 2 -->",
         "\t\t<div data-wizard-step=\"2\" data-wizard-label=\"${3:Крок 2}\">",
         "\t\t\t<div class=\"form-group\">",
         "\t\t\t\t<input type=\"email\" name=\"email\" placeholder=\"${12:Email}\"",
         "\t\t\t\t\tdata-wizard-field=\"${12:Email}\"",
