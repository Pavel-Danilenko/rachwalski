   "Slider new component": {
      "prefix": "fslider-new",
      "scope": "astro",
      "description": "Slider — новий самодостатній компонент (ReviewsSlider, HeroSlider тощо). Всі дані і конфіг всередині.",
      "body": [
         "---",
         "import \"swiper/css\";",
         "import \"@styles/components/sliders/_slider.scss\";",
         "",
         "const slides = [",
         "\t{ title: \"${2:Заголовок 1}\", text: \"${3:Текст 1}\" },",
         "\t{ title: \"${4:Заголовок 2}\", text: \"${5:Текст 2}\" },",
         "\t{ title: \"${6:Заголовок 3}\", text: \"${7:Текст 3}\" },",
         "];",
         "---",
         "",
         "<div class=\"${1:my}-slider\">",
         "\t<div class=\"swiper\">",
         "\t\t<div class=\"swiper-wrapper\">",
         "\t\t\t{slides.map((s) => (",
         "\t\t\t\t<div class=\"swiper-slide\">",
         "\t\t\t\t\t<div class=\"${1:my}-card\">",
         "\t\t\t\t\t\t<h3>{s.title}</h3>",
         "\t\t\t\t\t\t<p>{s.text}</p>",
         "\t\t\t\t\t</div>",
         "\t\t\t\t</div>",
         "\t\t\t))}",
         "\t\t</div>",
         "\t\t<div class=\"${1:my}-slider__pagination swiper-pagination\"></div>",
         "\t</div>",
         "",
         "\t<button class=\"slider__arrow slider__arrow--prev\" aria-label=\"Попередній\">",
         "\t\t<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 18 9 12 15 6\"/></svg>",
         "\t</button>",
         "\t<button class=\"slider__arrow slider__arrow--next\" aria-label=\"Наступний\">",
         "\t\t<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>",
         "\t</button>",
         "</div>",
         "",
         "<style>",
         "\t.${1:my}-slider {",
         "\t\tposition: relative;",
         "\t\tpadding-bottom: 2.5rem;",
         "\t}",
         "",
         "\t.${1:my}-slider__pagination {",
         "\t\tposition: absolute;",
         "\t\tbottom: 0.5rem;",
         "\t\tleft: 0; right: 0;",
         "\t\tdisplay: flex;",
         "\t\tjustify-content: center;",
         "\t\tgap: 0.375rem;",
         "\t}",
         "",
         "\t.${1:my}-card {",
         "\t\tpadding: 1.5rem;",
         "\t\tbackground: var(--color-bg, #fff);",
         "\t\tborder: 1px solid var(--color-border, #eee);",
         "\t\tborder-radius: var(--radius-lg, 16px);",
         "\t\theight: 100%;",
         "\t}",
         "</style>",
         "",
         "<script>",
         "\timport Swiper from \"swiper\";",
         "\timport { Navigation, Pagination } from \"swiper/modules\";",
         "",
         "\tfunction init() {",
         "\t\tdocument.querySelectorAll<HTMLElement>(\".${1:my}-slider\").forEach((el) => {",
         "\t\t\tif (el.dataset.swiperInit) return;",
         "\t\t\tel.dataset.swiperInit = \"true\";",
         "",
         "\t\t\tnew Swiper(el.querySelector<HTMLElement>(\".swiper\")!, {",
         "\t\t\t\tmodules: [Navigation, Pagination],",
         "\t\t\t\tslidesPerView: 1,",
         "\t\t\t\tspaceBetween: 16,",
         "\t\t\t\tgrabCursor: true,",
         "\t\t\t\tloop: ${8|true,false|},",
         "",
         "\t\t\t\tbreakpoints: {",
         "\t\t\t\t\t640:  { slidesPerView: ${9:2}, spaceBetween: 20 },",
         "\t\t\t\t\t1024: { slidesPerView: ${10:3}, spaceBetween: 24 },",
         "\t\t\t\t},",
         "",
         "\t\t\t\tnavigation: {",
         "\t\t\t\t\tprevEl: el.querySelector(\".slider__arrow--prev\"),",
         "\t\t\t\t\tnextEl: el.querySelector(\".slider__arrow--next\"),",
         "\t\t\t\t},",
         "",
         "\t\t\t\tpagination: {",
         "\t\t\t\t\tel: el.querySelector(\".${1:my}-slider__pagination\"),",
         "\t\t\t\t\tclickable: true,",
         "\t\t\t\t},",
         "\t\t\t});",
         "\t\t});",
         "\t}",
         "",
         "\tinit();",
         "\tdocument.addEventListener(\"astro:page-load\", init);",
         "</script>",
         "$0",
      ],
   },

