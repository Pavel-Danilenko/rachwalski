---
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import Popups from "@components/popups/Popups.astro";
import MobileBookingBar from "@components/ui/MobileBookingBar.astro";
import ScrollToTop from "@components/ui/ScrollToTop.astro";
import MusicToggle from "@components/media/MusicToggle.astro";
import IconSprite from "@components/ui/IconSprite.astro";
import PreloaderLogo from "@components/interactive/PreloaderLogo.astro";
import "@styles/main.scss";
import "swiper/css";
import "swiper/css/effect-fade";
import "swiper/css/effect-cards";
import "swiper/css/effect-creative";
import "swiper/css/effect-coverflow";
import { googleFonts, buildGoogleFontsUrl } from "@config/fonts";

import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import footerBgDefault from "@assets/img/footer/footer-bg.png";
// Дефолтний фоновий трек — тепер глобальний (кнопка на всіх сторінках, не
// тільки на головній). musicSrc/musicWebm пропси лишаються як можливість
// перевизначити трек на конкретній сторінці за потреби.
import defaultAudioMp3 from "@assets/audio/2005-instrumental-eric-heron-musicbed.mp3";
import defaultAudioWebm from "@assets/audio/2005-instrumental-eric-heron-musicbed.webm";

interface Props {
   title?: string;
   description?: string;
   ogImage?: string;
   lang?: string;
   noindex?: boolean;
   stickyHeader?: boolean;
   footerBg?: ImageMetadata;
   // Barba namespace — для таргетованих анімацій між конкретними сторінками
   namespace?: string;
   // Приховати Header, Footer та MobileBookingBar (для самостійних сторінок-заглушок)
   hideChrome?: boolean;
   // Сторінка має відео-інтро (Video з pageIntro): хедер прихований до кінця відео,
   // скрол заблокований, звичайний прелоадер не показується
   introVideo?: boolean;
   // Тип прелоадера: "default" = кастомний знак→RACHWALSKI, "none" = без прелоадера
   preloader?: "default" | "none";
   // Фонова музика — передай src/webm щоб показати кнопку звуку (тільки на сторінках з відео)
   musicSrc?: string;
   musicWebm?: string;
   // ── Перехід між сторінками (Barba) — керується АТРИБУТАМИ, без правки barba.config.js ──
   // Назва анімації: "fade" | "slide-up" | "blur" | "clip" | "iris" | "morph" | ... (див. barba.config.js)
   transition?: string;
   // Тривалість (секунди). Дефолти нижче — глобальні; перевизнач на сторінці за потреби.
   transitionLeave?: number;
   transitionEnter?: number;
   // GSAP ease, напр. "power2.in" / "power2.out" / "expo.out"
   transitionEaseLeave?: string;
   transitionEaseEnter?: string;
   // Колір overlay між сторінками (для шторок/iris). Напр. "#000" | "var(--color-primary)"
   transitionColor?: string;
}

const {
   // [SEO] Назва сторінки — відображається у вкладці браузера та результатах пошуку (50–60 символів)
   title = "Назва сайту — Коротке гасло або ключове слово",

   // [SEO] Короткий опис сторінки — відображається під назвою у пошуку (120–155 символів)
   description = "Тестовий опис сторінки. Замін на реальний текст — він відображається у пошуку та при шерінгу у соцмережах.",

   // [SEO] OG-зображення для шерінгу — рекомендовано 1200×630px, замін /public/og-image.svg на реальний JPG/PNG
   ogImage = "/og-image.svg",

   lang = "fr",
   noindex = false,
   stickyHeader = false,
   footerBg,
   namespace = "default",
   hideChrome = false,
   introVideo = false,
   preloader = "default",
   musicSrc = defaultAudioMp3,
   musicWebm = defaultAudioWebm,
   // Глобальний дефолт анімації переходу для всього сайту (міняєш тут одним словом).
   transition = "fade",
   // Глобальні дефолти тривалості переходу (трохи довші — щоб стилі встигали застосуватись).
   transitionLeave = 0.8,
   transitionEnter = 1,
   transitionEaseLeave,
   transitionEaseEnter,
   transitionColor,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;

// og:image має бути абсолютним URL — інакше Facebook/Telegram не підхоплять картинку
const ogImageAbsolute = ogImage.startsWith("http")
   ? ogImage
   : new URL(ogImage, siteOrigin).href;

const googleFontsUrl = buildGoogleFontsUrl(googleFonts);

// [SEO] Назва сайту для og:site_name — замін на реальну
const siteName = "Назва сайту";

const resolvedFooterBg = await getImage({
   src: footerBg ?? footerBgDefault,
   format: "webp",
   quality: 90,
});
---

<!doctype html>
<html lang={lang} class:list={[introVideo && "intro-video"]}>
   <head>
      {
         introVideo && (
            // Якщо при релоаді сторінка з відео-інтро була проскролена —
            // браузер відновлює попередню позицію скролу, і відео грає
            // поза екраном. Примусово скидаємо на верх, де відео.
            <script is:inline>
               history.scrollRestoration = "manual"; window.scrollTo(0, 0);
            </script>
         )
      }
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      <meta name="generator" content={Astro.generator} />

      <title>{title}</title>
      {description && <meta name="description" content={description} />}
      <link rel="canonical" href={canonicalUrl} />
      {noindex && <meta name="robots" content="noindex, nofollow" />}

      <meta property="og:site_name" content={siteName} />
      <meta property="og:title" content={title} />
      {description && <meta property="og:description" content={description} />}
      <meta property="og:url" content={canonicalUrl} />
      <meta property="og:type" content="website" />
      <meta property="og:locale" content={lang === "uk" ? "uk_UA" : lang} />
      <meta property="og:image" content={ogImageAbsolute} />

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      {description && <meta name="twitter:description" content={description} />}
      <meta name="twitter:image" content={ogImageAbsolute} />

      {
         googleFontsUrl && (
            <>
               <link rel="preconnect" href="https://fonts.googleapis.com" />
               <link
                  rel="preconnect"
                  href="https://fonts.gstatic.com"
                  crossorigin
               />
               <link rel="stylesheet" href={googleFontsUrl} />
            </>
         )
      }
   </head>
   <body>
      {
         preloader === "default" && (
            <PreloaderLogo
               collapseAt={1100}
               dockAt={1350}
               dockDuration={850}
               dockScale={1.5}
               waveAt={2000}
               waveDuration={1300}
               legAt={2400}
               drawAt={2900}
               petalDuration={800}
               petalStep={80}
               dissolveDuration={900}
               drawDuration={1000}
               placeDuration={700}
            />
         )
      }
      <IconSprite />

      <div class="wrapper" data-barba="wrapper">
         {!hideChrome && <Header sticky={stickyHeader} />}
         <div
            data-barba="container"
            data-barba-namespace={namespace}
            data-footer-bg={resolvedFooterBg.src}
            data-tr-animation={transition}
            data-tr-leave={transitionLeave}
            data-tr-enter={transitionEnter}
            data-tr-ease-leave={transitionEaseLeave}
            data-tr-ease-enter={transitionEaseEnter}
            data-tr-color={transitionColor}
         >
            {
               (musicSrc || musicWebm) && (
                  <div
                     data-music-page
                     data-src={musicSrc || ""}
                     data-webm={musicWebm || ""}
                     hidden
                  />
               )
            }
            <slot />
         </div>

         {!hideChrome && <Footer bgSrc={footerBg} />}
      </div>

      <Popups />
      {!hideChrome && <MobileBookingBar />}
      {!hideChrome && <ScrollToTop />}
      {!hideChrome && <MusicToggle class="video-banner__music" />}

      <script>
         import "@scripts/app";
      </script>
   </body>
</html>
