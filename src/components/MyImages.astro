---
// src/components/MyImage.astro
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
   src: ImageMetadata;
   alt: string;
   width?: number;
   height?: number;
   class?: string;
   wrapperClass?: string;
   loading?: "lazy" | "eager";
   sizes?: string;
   quality?: number;
   formats?: ("avif" | "webp" | "jpeg" | "png")[];
   widths?: number[];
   imgAttrs?: Record<string, string | boolean | number | undefined>;
   includeLegacyFallback?: boolean;
   "sf-image"?: string; // для Shopify статичних зображень
   "sf-field"?: string; // для Shopify динамічних даних (product, article...)
}

const {
   src,
   alt,
   width,
   height,
   class: imgClass = "",
   wrapperClass = "",
   loading = "lazy",
   sizes = "(max-width: 768px) 100vw, 800px",
   quality = 80,
   formats = ["webp"],
   widths = [400, 800, 1200],
   imgAttrs = {},
   includeLegacyFallback = false,
   "sf-image": sfImage,
   "sf-field": sfField,
   ...restProps
} = Astro.props;

const finalFormats = includeLegacyFallback ? [...formats, "jpeg"] : formats;
const fallbackFormat = includeLegacyFallback ? "jpeg" : "webp";

const aspectRatio = width && height ? `${width}/${height}` : undefined;

const sfProps = sfImage ? { "sf-image": sfImage } : {};
const sfFieldProps = sfField ? { "sf-field": sfField } : {};
---

<div
   class={`image-wrapper ${wrapperClass}`}
   style={aspectRatio ? `--aspect-ratio: ${aspectRatio};` : ""}
   {...sfProps}
   {...sfFieldProps}
>
   <Picture
      src={src}
      alt={alt}
      formats={finalFormats}
      fallbackFormat={fallbackFormat}
      widths={widths}
      sizes={sizes}
      quality={quality}
      loading={loading}
      class={`img ${imgClass}`}
      {...imgAttrs}
      {...restProps}
   />
</div>

<style>
   .image-wrapper {
      width: 100%;
   }

   .image-wrapper img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
   }

   /* .image-wrapper[style*="--aspect-ratio"] {
      aspect-ratio: var(--aspect-ratio);
   }

   .image-wrapper[style*="--aspect-ratio"] img {
      height: 100%;
   } */
</style>
