---
import "@styles/components/_progress-stepper.scss";

interface Step {
   label: string;
   description?: string;
}

interface Props {
   steps: Step[];
   currentStep: number;
   id?: string;
   orientation?: "horizontal" | "vertical";
   size?: "sm" | "md" | "lg";
   color?: string;
   showLabels?: boolean;
   showDescriptions?: boolean;
   showLine?: boolean;
   showNumbers?: boolean;
   showCheckmarks?: boolean;
   responsive?: boolean;
   class?: string;
   // 🎨 Кастомні іконки через спрайт
   checkIcon?: string; // іконка для завершеного кроку (замість галочки)
   activeIcon?: string; // іконка для активного кроку (опціонально)
}

const {
   steps,
   currentStep,
   id,
   orientation = "horizontal",
   size = "md",
   color,
   showLabels = true,
   showDescriptions = true,
   showLine = true,
   showNumbers = true,
   showCheckmarks = true,
   responsive = true,
   class: className,
   checkIcon,
   activeIcon,
   ...rest
} = Astro.props;

const totalSteps = steps.length;
const progressPercentage = ((currentStep - 1) / (totalSteps - 1)) * 100;

const inlineStyles = [
   `--stepper-progress: ${progressPercentage}%`,
   color && `--stepper-color: ${color}`,
]
   .filter(Boolean)
   .join("; ");
---

<div
   id={id}
   class:list={[
      "progress-stepper",
      `progress-stepper--${orientation}`,
      `progress-stepper--${size}`,
      !showLabels && "progress-stepper--no-labels",
      !showDescriptions && "progress-stepper--no-descriptions",
      !showLine && "progress-stepper--no-line",
      !showNumbers && "progress-stepper--no-numbers",
      !showCheckmarks && "progress-stepper--no-checkmarks",
      responsive && "progress-stepper--responsive",
      className,
   ]}
   data-current-step={currentStep}
   data-total-steps={totalSteps}
   data-orientation={orientation}
   data-check-icon={checkIcon || undefined}
   data-active-icon={activeIcon || undefined}
   style={inlineStyles}
   {...rest}
>
   <div class="progress-stepper__container">
      {
         steps.map((step, index) => {
            const stepNumber = index + 1;
            const isActive = stepNumber === currentStep;
            const isCompleted = stepNumber < currentStep;
            const isLast = index === steps.length - 1;

            return (
               <>
                  <div
                     class:list={[
                        "progress-stepper__step",
                        isActive && "progress-stepper__step--active",
                        isCompleted && "progress-stepper__step--completed",
                     ]}
                     data-step={stepNumber}
                  >
                     <div class="progress-stepper__step-circle">
                        {showCheckmarks && isCompleted ? (
                           // ✅ Завершений крок — кастомна іконка або дефолтна галочка
                           checkIcon ? (
                              <svg class="progress-stepper__check-icon">
                                 <use href={`#icon-${checkIcon}`} />
                              </svg>
                           ) : (
                              <svg
                                 class="progress-stepper__check-icon"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="3"
                              >
                                 <polyline points="20 6 9 17 4 12" />
                              </svg>
                           )
                        ) : isActive && activeIcon ? (
                           // ✅ Активний крок — кастомна іконка (якщо передана)
                           <svg class="progress-stepper__active-icon">
                              <use href={`#icon-${activeIcon}`} />
                           </svg>
                        ) : showNumbers ? (
                           // Дефолт — номер кроку
                           <span class="progress-stepper__step-number">
                              {stepNumber}
                           </span>
                        ) : null}
                     </div>

                     {showLabels && (
                        <div class="progress-stepper__step-content">
                           <div class="progress-stepper__step-label">
                              {step.label}
                           </div>
                           {showDescriptions && step.description && (
                              <div class="progress-stepper__step-description">
                                 {step.description}
                              </div>
                           )}
                        </div>
                     )}
                  </div>

                  {showLine && !isLast && (
                     <div class="progress-stepper__line">
                        <div class="progress-stepper__line-fill" />
                     </div>
                  )}
               </>
            );
         })
      }
   </div>
</div>

<script>
   import "@scripts/init/form-wizard";
</script>
