---
interface Props {
   id: string;
   backdropClose?: boolean;
   maxWidth?: string;
   class?: string;
}

const {
   id,
   backdropClose = true,
   maxWidth,
   class: customClass = "",
} = Astro.props;
---

<div
   data-popup={id}
   data-backdrop-close={backdropClose}
   class="popup"
   aria-hidden="true"
   role="dialog"
   aria-modal="true"
>
   <div class="popup__wrapper">
      <div
         class:list={["popup__content", customClass]}
         style={maxWidth ? `max-width: ${maxWidth}` : undefined}
      >
         <slot />
      </div>
   </div>
</div>
