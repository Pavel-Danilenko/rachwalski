---
import "@styles/components/forms/_custom-radio.scss";

interface Props {
   name: string;
   value: string;
   id?: string;
   label?: string;
   required?: boolean;
   checked?: boolean;
   disabled?: boolean;
   class?: string;
   [key: string]: any;
}

const {
   name,
   value,
   id = `radio-${name}-${value}`,
   label,
   required = false,
   checked = false,
   disabled = false,
   class: className = "",
   ...rest
} = Astro.props;
---

<label class={`custom-radio ${className}`}>
   <input
      type="radio"
      {id}
      {name}
      {value}
      {required}
      {checked}
      {disabled}
      {...rest}
      class="custom-radio__input"
   />

   <span class="custom-radio__circle"></span>

   <span class="custom-radio__label">
      <slot>{label}</slot>
   </span>
</label>
