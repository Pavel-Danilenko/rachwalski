---
import "@styles/components/forms/_password-input.scss";

interface RequirementTexts {
   length?: string;
   uppercase?: string;
   lowercase?: string;
   numbers?: string;
   special?: string;
}

interface Props {
   name: string;
   placeholder?: string;
   required?: boolean;
   disabled?: boolean;
   autocomplete?: string;

   // Функціонал
   showStrength?: boolean;
   showRequirements?: boolean;
   minLength?: number;
   requireUppercase?: boolean;
   requireLowercase?: boolean;
   requireNumbers?: boolean;
   requireSpecial?: boolean;

   // i18n тексти
   toggleLabel?: string;
   capsLockText?: string;
   strengthWeak?: string;
   strengthMedium?: string;
   strengthStrong?: string;
   requirementTexts?: RequirementTexts;

   // Валідація
   errorRequired?: string;
   errorMinLength?: string;
   errorWeak?: string;
}

const {
   name,
   placeholder = "",
   required = false,
   disabled = false,
   autocomplete = "current-password",

   showStrength = false,
   showRequirements = false,
   minLength = 8,
   requireUppercase = false,
   requireLowercase = false,
   requireNumbers = false,
   requireSpecial = false,

   toggleLabel = "Toggle password visibility",
   capsLockText = "Caps Lock is on",
   strengthWeak = "Weak",
   strengthMedium = "Medium",
   strengthStrong = "Strong",
   requirementTexts = {},

   errorRequired,
   errorMinLength,
   errorWeak,
} = Astro.props;

const hasRequirements =
   showRequirements &&
   (minLength || requireUppercase || requireLowercase || requireNumbers || requireSpecial);
---

<div class="password-input" data-password-input>

   <!-- Поле вводу + toggle -->
   <div class="password-input__field">
      <input
         type="password"
         name={name}
         class="password-input__input"
         placeholder={placeholder}
         required={required}
         disabled={disabled}
         autocomplete={autocomplete}
         data-min-length={minLength}
         data-error-required={errorRequired}
         data-error-min-length={errorMinLength}
         data-error-weak={errorWeak}
      />

      <button
         type="button"
         class="password-input__toggle"
         aria-label={toggleLabel}
         tabindex="-1"
         disabled={disabled}
      >
         <svg class="password-input__eye-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <!-- Форма ока — прижмурюється при закритті -->
            <path class="eye-shape" d="M1.5 12C4 5.5 8 3 12 3C16 3 20 5.5 22.5 12C20 18.5 16 21 12 21C8 21 4 18.5 1.5 12Z" stroke-width="1.5"/>

            <!-- Зіниця + iris — рухаються за курсором -->
            <g class="eye-gaze">
               <circle class="eye-iris"       cx="12" cy="12" r="4"   stroke-width="1.25"/>
               <circle class="eye-pupil"      cx="12" cy="12" r="2"   fill="currentColor" stroke="none"/>
               <circle class="eye-catchlight" cx="13" cy="11" r="0.7" fill="white"        stroke="none" opacity="0.7"/>
            </g>

            <!-- Slash — намальовується коли пароль видно -->
            <line class="eye-slash" x1="3" y1="3" x2="21" y2="21" stroke-width="1.5"/>
         </svg>
      </button>
   </div>

   <!-- Caps Lock попередження -->
   <div class="password-input__capslock" data-capslock style="display:none">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
         <path d="M12 2L2 7l10 5 10-5-10-5z"/>
         <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
      </svg>
      {capsLockText}
   </div>

   <!-- Strength meter -->
   {showStrength && (
      <div
         class="password-input__strength"
         data-strength
         data-weak={strengthWeak}
         data-medium={strengthMedium}
         data-strong={strengthStrong}
      >
         <div class="password-input__strength-bars">
            <span class="password-input__strength-bar" />
            <span class="password-input__strength-bar" />
            <span class="password-input__strength-bar" />
         </div>
         <span class="password-input__strength-label" />
      </div>
   )}

   <!-- Requirements checklist -->
   {hasRequirements && (
      <ul class="password-input__requirements" data-requirements>
         {minLength && (
            <li data-req="length" data-min={minLength}>
               <span class="password-input__req-icon" aria-hidden="true" />
               {requirementTexts.length ?? `Min ${minLength} characters`}
            </li>
         )}
         {requireUppercase && (
            <li data-req="uppercase">
               <span class="password-input__req-icon" aria-hidden="true" />
               {requirementTexts.uppercase ?? "Uppercase letter"}
            </li>
         )}
         {requireLowercase && (
            <li data-req="lowercase">
               <span class="password-input__req-icon" aria-hidden="true" />
               {requirementTexts.lowercase ?? "Lowercase letter"}
            </li>
         )}
         {requireNumbers && (
            <li data-req="numbers">
               <span class="password-input__req-icon" aria-hidden="true" />
               {requirementTexts.numbers ?? "Number"}
            </li>
         )}
         {requireSpecial && (
            <li data-req="special">
               <span class="password-input__req-icon" aria-hidden="true" />
               {requirementTexts.special ?? "Special character"}
            </li>
         )}
      </ul>
   )}

</div>

<script>
   import "@scripts/init/password-input";
</script>
