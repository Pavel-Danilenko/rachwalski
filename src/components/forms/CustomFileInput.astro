---
import "@styles/components/forms/_custom-file-input.scss";
import Icon from "@components/ui/Icon.astro";

type Variant = "default" | "minimal";

interface Props {
   name: string;
   id?: string;
   variant?: Variant;

   // Валідація
   required?: boolean;
   accept?: string;
   maxSize?: number;
   multiple?: boolean;

   // Відображення — всі false за замовчуванням, підключаються через пропи
   showFileList?: boolean;
   showPreview?: boolean;
   maxFiles?: number;
   showFileListAccordion?: boolean;
   accordionDefaultOpen?: boolean;
   showRemoveAll?: boolean;
   showButtonCounter?: boolean;
   showProgress?: boolean;
   showDropZone?: boolean;
   showClearButton?: boolean;
   showMaxFilesHint?: boolean;
   showTotalSize?: boolean;
   showFileTypeBadges?: boolean;
   enableSort?: boolean;
   compactList?: boolean;
   compact?: boolean;

   // Іконки через спрайт (назва файлу з src/icons/*.svg, без розширення)
   buttonIconPosition?: "left" | "right"; // позиція іконки в кнопці, default: "left"
   buttonIcon?: string; // іконка в кнопці
   clearIcon?: string; // іконка в кнопці "очистити"
   accordionIcon?: string; // іконка стрілки accordion
   removeIcon?: string; // іконка видалення файлу (JS)
   removeAllIcon?: string; // іконка "видалити всі"
   emptyIcon?: string; // іконка empty state
   iconPdf?: string; // іконка для PDF у списку (JS)
   iconDoc?: string; // іконка для DOC/DOCX у списку (JS)
   iconDefault?: string; // іконка для решти файлів у списку (JS)

   // i18n тексти
   buttonText?: string;
   buttonTextWithFiles?: string;
   dragText?: string;
   dropZoneText?: string;
   fileListText?: string;
   fileListButtonText?: string;
   removeFileText?: string;
   removeAllText?: string;
   clearButtonText?: string;
   maxFilesText?: string;
   maxFilesHintText?: string;
   fileSizeText?: string;
   emptyStateText?: string;
   progressText?: string;
   totalSizeText?: string;
   sortByNameText?: string;
   sortBySizeText?: string;
   sortByTypeText?: string;

   // Повідомлення після успішного додавання файлу
   successText?: string;

   // Валідаційні помилки
   errorRequired?: string;
   errorFileType?: string;
   errorFileSize?: string;
   errorMaxFiles?: string;

   class?: string;
}

const {
   name,
   id = `file-${name}`,
   variant = "default",
   required = false,
   accept,
   maxSize,
   multiple = false,

   // Всі false за замовчуванням — підключаються тільки через пропи
   showFileList = false,
   showPreview = false,
   maxFiles,
   showFileListAccordion = false,
   accordionDefaultOpen = false,
   showRemoveAll = false,
   showButtonCounter = false,
   showProgress = false,
   showDropZone = false,
   showClearButton = false,
   showMaxFilesHint = false,
   showTotalSize = false,
   showFileTypeBadges = false,
   enableSort = false,
   compactList = false,
   compact = false,

   // Іконки — undefined = не рендерити
   buttonIconPosition = "left",
   buttonIcon,
   clearIcon,
   accordionIcon,
   removeIcon,
   removeAllIcon,
   emptyIcon,
   iconPdf,
   iconDoc,
   iconDefault,

   buttonText = "Додати файл",
   buttonTextWithFiles = "Додати ще ({count}/{max})",
   dragText = "Або перетягніть файл сюди",
   dropZoneText = "Відпустіть файли тут",
   fileListText = "Обрані файли:",
   fileListButtonText = "Переглянути файли ({count})",
   removeFileText = "Видалити",
   removeAllText = "Видалити всі",
   clearButtonText = "Очистити",
   maxFilesText = "Максимум {max} файлів",
   maxFilesHintText = "Макс. {max} файлів",
   fileSizeText = "MB",
   emptyStateText = "Файлів поки немає",
   progressText = "Завантаження... {percent}%",
   totalSizeText = "Загальний розмір: {size}",
   sortByNameText = "За назвою",
   sortBySizeText = "За розміром",
   sortByTypeText = "За типом",
   errorRequired,
   errorFileType,
   errorFileSize,
   errorMaxFiles,
   successText,
   class: className = "",
} = Astro.props;
---

<!-- Основний блок -->
<div
   class:list={[
      "custom-file-input",
      `custom-file-input--${variant}`,
      compact && "custom-file-input--compact",
      className,
   ]}
   data-file-input
   data-variant={variant}
   data-button-text={buttonText}
   data-button-text-with-files={buttonTextWithFiles}
   data-drag-text={dragText}
   data-drop-zone-text={dropZoneText}
   data-show-file-list={showFileList}
   data-show-preview={showPreview}
   data-file-list-text={fileListText}
   data-file-list-button-text={fileListButtonText}
   data-remove-file-text={removeFileText}
   data-remove-all-text={removeAllText}
   data-clear-button-text={clearButtonText}
   data-file-size-text={fileSizeText}
   data-empty-state-text={emptyStateText}
   data-progress-text={progressText}
   data-total-size-text={totalSizeText}
   data-sort-by-name-text={sortByNameText}
   data-sort-by-size-text={sortBySizeText}
   data-sort-by-type-text={sortByTypeText}
   data-max-files={maxFiles}
   data-max-files-text={maxFilesText}
   data-max-files-hint-text={maxFilesHintText}
   data-show-accordion={showFileListAccordion}
   data-accordion-default-open={accordionDefaultOpen}
   data-show-remove-all={showRemoveAll}
   data-show-button-counter={showButtonCounter}
   data-show-progress={showProgress}
   data-show-drop-zone={showDropZone}
   data-show-clear-button={showClearButton}
   data-show-max-files-hint={showMaxFilesHint}
   data-show-total-size={showTotalSize}
   data-show-file-type-badges={showFileTypeBadges}
   data-enable-sort={enableSort}
   data-compact-list={compactList}
   data-icon-pdf={iconPdf}
   data-icon-doc={iconDoc}
   data-icon-default={iconDefault}
   data-remove-icon={removeIcon}
>
   <!-- Кнопка — єдине що є завжди -->
   <button type="button" class="custom-file-input__button btn white-btn">
      {
         buttonIcon && buttonIconPosition === "left" && (
            <Icon name={buttonIcon} class="custom-file-input__icon" />
         )
      }
      <span class="custom-file-input__button-text">{buttonText}</span>
      {
         buttonIcon && buttonIconPosition === "right" && (
            <Icon name={buttonIcon} class="custom-file-input__icon" />
         )
      }
   </button>

   {successText && (
      <span class="custom-file-input__success-text">{successText}</span>
   )}

   {showDropZone && <p class="custom-file-input__drag-text">{dragText}</p>}

   {
      showClearButton && (
         <button
            type="button"
            class="custom-file-input__clear-button"
            style="display:none"
         >
            {clearIcon && <Icon name={clearIcon} />}
            <span>{clearButtonText}</span>
         </button>
      )
   }

   {
      showMaxFilesHint && maxFiles && (
         <p
            class="custom-file-input__max-files-hint"
            data-text={maxFilesHintText}
         >
            {maxFilesHintText.replace("{max}", maxFiles.toString())}
         </p>
      )
   }

   {
      showDropZone && (
         <div class="custom-file-input__drop-zone-overlay">
            <p class="custom-file-input__drop-zone-text">{dropZoneText}</p>
         </div>
      )
   }
</div>

<!-- Прогрес — тільки якщо showProgress -->
{
   showProgress && (
      <div class="custom-file-input__progress" style="display:none">
         <div class="custom-file-input__progress-bar">
            <div class="custom-file-input__progress-fill" />
         </div>
         <span class="custom-file-input__progress-text">{progressText}</span>
      </div>
   )
}

<!-- Список файлів — тільки якщо showFileList -->
{
   showFileList && (
      <div class="custom-file-input__file-list">
         {showFileListAccordion && (
            <button type="button" class="custom-file-input__accordion-toggle">
               <span class="custom-file-input__accordion-title">
                  {fileListButtonText}
               </span>
               {accordionIcon && (
                  <Icon
                     name={accordionIcon}
                     class="custom-file-input__accordion-icon"
                  />
               )}
            </button>
         )}

         <div
            class={
               showFileListAccordion
                  ? "custom-file-input__accordion-content"
                  : undefined
            }
         >
            <div class="custom-file-input__files-header">
               <p class="custom-file-input__file-list-title">{fileListText}</p>
               <div class="custom-file-input__header-actions">
                  {enableSort && (
                     <select class="custom-file-input__sort-select">
                        <option value="name">{sortByNameText}</option>
                        <option value="size">{sortBySizeText}</option>
                        <option value="type">{sortByTypeText}</option>
                     </select>
                  )}
                  {showRemoveAll && (
                     <button
                        type="button"
                        class="custom-file-input__remove-all-btn"
                        style="display:none"
                     >
                        {removeAllIcon && <Icon name={removeAllIcon} />}
                        <span>{removeAllText}</span>
                     </button>
                  )}
               </div>
            </div>

            {showTotalSize && (
               <div class="custom-file-input__total-size" style="display:none">
                  {totalSizeText}
               </div>
            )}

            <div
               class:list={[
                  "custom-file-input__files",
                  compactList && "custom-file-input__files--compact",
               ]}
            />

            <div class="custom-file-input__empty-state" style="display:none">
               {emptyIcon && (
                  <Icon
                     name={emptyIcon}
                     class="custom-file-input__empty-icon"
                  />
               )}
               <p>{emptyStateText}</p>
            </div>
         </div>
      </div>
   )
}

<!-- Прихований input -->
<input
   type="file"
   {id}
   {name}
   {accept}
   {required}
   {multiple}
   class="custom-file-input__hidden"
   data-max-size={maxSize}
   data-max-files={maxFiles}
   data-error-required={errorRequired}
   data-error-file-type={errorFileType}
   data-error-file-size={errorFileSize}
   data-error-max-files={errorMaxFiles}
/>

<!-- Template для file-item — без SVG, іконки вставляє JS через спрайт -->
{
   showFileList && (
      <template id={`file-item-tpl-${name}`} class="file-item-template">
         <div class="custom-file-input__file-item">
            <div class="custom-file-input__file-preview" />
            <div class="custom-file-input__file-info">
               <div class="custom-file-input__file-top-row">
                  <span class="custom-file-input__file-name" />
               </div>
               <span class="custom-file-input__file-size" />
            </div>
            <button type="button" class="custom-file-input__remove-btn" />
         </div>
      </template>
   )
}

<script>
   import "@scripts/init/custom-file-input";
</script>
