---
import "@styles/components/countdown/_countdown.scss";

export interface LabelValue {
   short: string;
   long: string;
}

export interface Labels {
   days: LabelValue;
   hours: LabelValue;
   minutes: LabelValue;
   seconds: LabelValue;
}

export type CountdownUnit = "days" | "hours" | "minutes" | "seconds";
export type LabelFormat = "short" | "long" | "none";
export type Variant = "tiles" | "inline" | "banner";
export type Animation = "none" | "fade" | "slide" | "flip";

export interface Props {
   /** Формат: "2025-12-31", "2025-12-31 23:59", "2025-12-31T23:59:00", "2025-12-31T23:59:00Z", "2025-12-31T23:59:00+02:00" */
   deadline: string | Date;
   variant?: Variant;
   labels?: Partial<Labels>;
   labelFormat?: LabelFormat;
   separator?: string;
   units?: CountdownUnit[];
   /** Анімація для всіх блоків */
   animation?: Animation;
   /** Анімація окремо для кожної одиниці. Перекриває animation */
   animationPerUnit?: Partial<Record<CountdownUnit, Animation>>;
   onExpire?: string;
   class?: string;
}

const {
   deadline,
   variant = "tiles",
   labels = {},
   labelFormat = "short",
   separator = ":",
   units = ["days", "hours", "minutes", "seconds"],
   animation = "none",
   animationPerUnit = {},
   onExpire,
   class: className,
} = Astro.props;

const normalizeDeadline = (d: string | Date): Date => {
   if (d instanceof Date) return d;
   return new Date(d.replace(" ", "T"));
};

const end = normalizeDeadline(deadline).getTime();
const now = Date.now();
let diff = Math.max(0, Math.floor((end - now) / 1000));

const days = Math.floor(diff / 86400);
diff -= days * 86400;
const hours = Math.floor(diff / 3600);
diff -= hours * 3600;
const minutes = Math.floor(diff / 60);
diff -= minutes * 60;
const seconds = diff;

const time: Record<string, number> = { days, hours, minutes, seconds };
const pad = (n: number): string => String(n).padStart(2, "0");

const hasSlotSep = await Astro.slots.has("separator");
const deadlineISO = normalizeDeadline(deadline).toISOString();

// Зберігаємо animationPerUnit як data-атрибут для JS
const animPerUnitJSON = JSON.stringify(animationPerUnit);
---

<div
   class:list={["countdown", `countdown--${variant}`, className]}
   data-countdown
   data-deadline={deadlineISO}
   data-units={units.join(",")}
   data-label-format={labelFormat}
   data-labels={JSON.stringify(labels)}
   data-animation={animation}
   data-animation-per-unit={animPerUnitJSON}
   data-has-slot-sep={hasSlotSep ? "true" : "false"}
   data-on-expire={onExpire}
>
   {
      units.map((unit: CountdownUnit, i: number) => {
         const unitAnim = animationPerUnit[unit] ?? animation;
         return (
            <>
               <div
                  class:list={[
                     "countdown__block",
                     `countdown__block--anim-${unitAnim}`,
                  ]}
                  data-unit={unit}
               >
                  <div class="countdown__num-wrap">
                     <span class="countdown__number">{pad(time[unit])}</span>
                  </div>
                  {labelFormat !== "none" && labels[unit] && (
                     <span class="countdown__label">
                        {labelFormat === "long"
                           ? labels[unit]!.long
                           : labels[unit]!.short}
                     </span>
                  )}
               </div>

               {i < units.length - 1 &&
                  (hasSlotSep ? (
                     <span
                        class="countdown__sep countdown__sep--slot"
                        aria-hidden="true"
                     >
                        <slot name="separator" />
                     </span>
                  ) : separator !== "" ? (
                     <span class="countdown__sep" aria-hidden="true">
                        {separator}
                     </span>
                  ) : null)}
            </>
         );
      })
   }
</div>

<script>
   import "@scripts/init/countdown";
</script>
