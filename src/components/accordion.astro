---
import "@styles/components/_accordion.scss";

interface Props {
   multiple?: boolean;
   defaultOpen?: number[];
   minWidth?: number;
   maxWidth?: number;
   duration?: number;
   class?: string;
   sfAccordion?: string;
}

const {
   multiple = false,
   defaultOpen = [],
   minWidth,
   maxWidth,
   duration = 400,
   class: className = "",
   sfAccordion,
} = Astro.props;

const defaultOpenStr = defaultOpen.join(",");
---

<div
   class={className}
   data-accordion
   data-accordion-multiple={multiple || undefined}
   data-accordion-default={defaultOpenStr || undefined}
   data-accordion-min={minWidth}
   data-accordion-max={maxWidth}
   data-accordion-duration={duration}
   sf-accordion={sfAccordion}
>
   <slot />
</div>

<script>
   // Динамічний імпорт - завантажується тільки коли компонент є на сторінці
   import("@scripts/init/accordion.js").then((module) => {
      module.initAccordion();
      document.addEventListener("astro:page-load", module.initAccordion);
   });
</script>
