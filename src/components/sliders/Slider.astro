---
import "@styles/components/sliders/_slider.scss";

interface Props {
   // Slides per view — per breakpoint
   slidesMobile?:   number | "auto";
   slidesTabletSm?: number | "auto";
   slidesTablet?:   number | "auto";
   slidesDesktop?:  number | "auto";

   // Space between — per breakpoint (px)
   spaceMobile?:   number;
   spaceTabletSm?: number;
   spaceTablet?:   number;
   spaceDesktop?:  number;

   // Navigation
   arrows?:         boolean; // desktop+tablet (default true)
   arrowsMobile?:   boolean; // mobile arrows (default false)
   pagination?:     boolean; // desktop+tablet (default true)
   paginationMobile?: boolean;
   paginationType?: "bullets" | "fraction" | "progressbar";

   // Behavior
   loop?:          boolean;
   speed?:         number;   // ms
   grabCursor?:    boolean;
   centered?:      boolean;

   // Autoplay
   autoplay?:      boolean;
   autoplayDelay?: number;   // ms

   // Effect
   effect?: "slide" | "fade" | "cards" | "creative" | "coverflow";

   class?: string;
}

const {
   slidesMobile   = 1,
   slidesTabletSm,
   slidesTablet,
   slidesDesktop,
   spaceMobile    = 16,
   spaceTabletSm,
   spaceTablet,
   spaceDesktop,
   arrows         = true,
   arrowsMobile   = false,
   pagination     = true,
   paginationMobile = true,
   paginationType = "bullets",
   loop           = false,
   speed          = 500,
   grabCursor     = true,
   centered       = false,
   autoplay       = false,
   autoplayDelay  = 3000,
   effect         = "slide",
   class: className = "",
} = Astro.props;
---

<div
   class={`slider ${className}`.trim()}
   data-slider
   data-slides-mobile={slidesMobile}
   data-slides-tablet-sm={slidesTabletSm ?? undefined}
   data-slides-tablet={slidesTablet ?? undefined}
   data-slides-desktop={slidesDesktop ?? undefined}
   data-space-mobile={spaceMobile}
   data-space-tablet-sm={spaceTabletSm ?? undefined}
   data-space-tablet={spaceTablet ?? undefined}
   data-space-desktop={spaceDesktop ?? undefined}
   data-arrows={arrows}
   data-arrows-mobile={arrowsMobile}
   data-pagination={pagination}
   data-pagination-mobile={paginationMobile}
   data-pagination-type={paginationType}
   data-loop={loop}
   data-speed={speed}
   data-grab-cursor={grabCursor}
   data-centered={centered}
   data-effect={effect}
   data-autoplay={autoplay ? autoplayDelay : undefined}
>
   <div class="swiper">
      <div class="swiper-wrapper">
         <slot />
      </div>
      <div class="slider__pagination swiper-pagination"></div>
   </div>

   <button class="slider__arrow slider__arrow--prev" aria-label="Попередній">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
         <polyline points="15 18 9 12 15 6"/>
      </svg>
   </button>
   <button class="slider__arrow slider__arrow--next" aria-label="Наступний">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
         <polyline points="9 18 15 12 9 6"/>
      </svg>
   </button>
</div>

<script>
   import "@scripts/init/slider";
</script>
