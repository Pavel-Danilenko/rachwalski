---
import Icon from "@components/ui/Icon.astro";

interface Props {
   class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["lecture-slider", className]} data-lecture-slider>
   <div class="swiper">
      <div class="swiper-wrapper">
         <slot />
      </div>
   </div>
   <div class="lecture-slider__controls">
      <button
         class="lecture-slider__arrow lecture-slider__arrow--prev"
         aria-label="Попередній"
      >
         <Icon name="arrow-dark-slider-left" />
      </button>
      <button
         class="lecture-slider__arrow lecture-slider__arrow--next"
         aria-label="Наступний"
      >
         <Icon name="arrow-dark-slider-right" />
      </button>
   </div>
</div>

<script>
   import "@scripts/sliders/lecture-slider";
</script>
