---
import Icon from "@components/ui/Icon.astro";

interface Props {
   title?: string;
   subtitle?: string;
}

const {
   title = "Lectures and presentations at international conferences",
   subtitle = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
} = Astro.props;
---

<div class="lecture-slider" data-lecture-slider>
   <div class="lecture-slider__header">
      <div class="lecture-slider__header-left">
         <h2 class="lecture-slider__title ct-black">{title}</h2>
         <p class="lecture-slider__subtitle ct-black fs-16">{subtitle}</p>
      </div>
      <div class="lecture-slider__controls">
         <button class="lecture-slider__arrow lecture-slider__arrow--prev" aria-label="Попередній">
            <Icon name="arrow-dark-slider-left" />
         </button>
         <button class="lecture-slider__arrow lecture-slider__arrow--next" aria-label="Наступний">
            <Icon name="arrow-dark-slider-right" />
         </button>
      </div>
   </div>

   <div class="swiper">
      <div class="swiper-wrapper">
         <slot />
      </div>
   </div>
</div>

<script>
   import "@scripts/sliders/lecture-slider";
</script>
