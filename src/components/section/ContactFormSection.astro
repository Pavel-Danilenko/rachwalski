---
import "@styles/components/section/_contact-form-section.scss";

import ContactForm from "@components/forms/ContactForm.astro";
import CustomSelect from "@components/forms/CustomSelect.astro";
import CustomPhoneInput from "@components/forms/CustomPhoneInput.astro";
import CustomFileInput from "@components/forms/CustomFileInput.astro";

interface Option {
   value: string;
   label: string;
}

interface Props {
   procedureOptions?: Option[];
   formKey?: string;
   successMessage?: string;
   errorMessage?: string;
   policyLink?: string;
}

const {
   procedureOptions = [],
   formKey = "contact",
   successMessage = "Thank you! We'll be in touch shortly.",
   errorMessage = "An error occurred. Please try again.",
   policyLink = "/privacy",
} = Astro.props;
---

<ContactForm
      backend="php"
      formKey={formKey}
      successMessage={successMessage}
      errorMessage={errorMessage}
      modalType="modal"
   >
      <div class="form-fields contact-form__fields">
         <div class="form-group contact-form__group">
            <label class="form-label contact-form__label" for="contact-name">
               Full name
            </label>
            <input
               class="contact-form__input"
               type="text"
               id="contact-name"
               name="name"
               placeholder="Full name"
               required
               data-error-required="Please enter your name"
               data-min-length="2"
               data-error-min-length="Name is too short"
            />
         </div>

         <div class="form-group contact-form__group">
            <label class="form-label contact-form__label" for="contact-email">
               Email
            </label>
            <input
               class="contact-form__input"
               type="email"
               id="contact-email"
               name="email"
               placeholder="email@example.com"
               required
               data-error-required="Please enter your email"
               data-error-email="Invalid email format"
               data-hint-corrected="Corrected to {domain}"
            />
         </div>

         <div class="form-group contact-form__group">
            <label class="form-label contact-form__label">Phone number</label>
            <CustomPhoneInput
               name="phone"
               defaultCountry="US"
               placeholder="(555) 000-0000"
               required
               showCode
               searchable
               searchPlaceholder="Search country..."
               noResultsText="Nothing found"
               errorRequired="Please enter your phone"
               errorPhone="Invalid phone number"
               class="contact-form__input"
            />
         </div>

         <div class="form-group contact-form__group">
            <label class="form-label contact-form__label">Procedure</label>
            <CustomSelect
               name="procedure"
               placeholder="Select option"
               required
               errorRequired="Please select a procedure"
               options={procedureOptions}
               class="contact-form__input"
               triggerClass="contact-form__trigger"
            />
         </div>

         <div class="form-group contact-form__group contact-form__group--full">
            <label
               class="form-label contact-form__label"
               for="contact-message"
            >
               Message
            </label>
            <textarea
               class="contact-form__textarea"
               id="contact-message"
               name="message"
               placeholder="Write your message..."
               required
               data-error-required="Please write a message"
               data-min-words="3"
               data-error-min-words="Minimum 3 words"
               data-error-spam="Looks like spam"
            ></textarea>
         </div>

         <div class="form-footer contact-form__footer contact-form__group--full">
            <div class="form-footer__file form-group contact-form__group">
               <CustomFileInput
                  name="files"
                  compact
                  accept="image/*,.pdf"
                  buttonText="Upload file"
                  buttonIcon="paper"
                  successText="File added"
                  class="contact-form__file"
               />
            </div>

            <div class="form-footer__right contact-form__right">
               <div class="form-footer__policy contact-form__policy">
                  By submitting the form I agree with the
                  <a
                     href={policyLink}
                     class="form-footer__policy-link contact-form__policy-link"
                  >
                     Privacy Policy
                  </a>
               </div>
               <button
                  class="contact-form__btn btn white-btn form-footer__submit"
                  type="submit"
               >
                  Send
               </button>
            </div>
         </div>
      </div>
</ContactForm>
