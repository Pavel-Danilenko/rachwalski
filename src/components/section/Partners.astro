---
import "@styles/components/section/_partners.scss";
import Icon from "@components/ui/Icon.astro";

interface Props {
   title?: string;
   titleHref?: string;
   logos?: { src: string; alt: string }[];
   visibleCount?: number;
   interval?: number;
   class?: string;
}

const {
   logos = [
      { src: "/img/partner/partner-1.svg", alt: "Partner 1" },
      { src: "/img/partner/partner-2.svg", alt: "Partner 2" },
      { src: "/img/partner/partner-3.svg", alt: "Partner 3" },
      { src: "/img/partner/partner-4.svg", alt: "Partner 4" },
      { src: "/img/partner/partner-5.svg", alt: "Partner 5" },
      { src: "/img/partner/partner-6.svg", alt: "Partner 6" },
      { src: "/img/partner/partner-7.svg", alt: "Partner 7" },
      { src: "/img/partner/partner-8.svg", alt: "Partner 8" },
      { src: "/img/partner/partner-9.svg", alt: "Partner 9" },
   ],
   visibleCount,
   interval = 2800,
   class: className,
} = Astro.props;

// Скільки слотів показувати: не більше 9 і не більше ніж є лого
const slots = Math.min(visibleCount ?? logos.length, 9);
---

<section
   class:list={["partners", className]}
   data-partners
   data-logos={JSON.stringify(logos)}
   data-visible={slots}
   data-interval={interval}
>
   <div class="partners__container">
      <a href="/rhinoplasty" class="partners__title fs-36 fw-500">
         Dr Martin Rachwalski in the media
         <Icon name="arrow-link-top" />
      </a>

      <div class="partners__stars" aria-hidden="true">
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
         <span class="partners__star-dot"></span>
      </div>

      <div class="partners__grid">
         {
            Array.from({ length: slots }).map((_, i) => (
               <div class="partners__slot" data-slot={i}>
                  <canvas class="partners__canvas" aria-hidden="true" />
                  <img class="partners__logo" src="" alt="" loading="lazy" />
               </div>
            ))
         }
      </div>
   </div>
</section>
