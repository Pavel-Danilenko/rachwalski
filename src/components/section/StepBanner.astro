---
import "@styles/components/section/_step-banner.scss";

interface Props {
   class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["step-banner__row br-20 glass", className]}>
   <div class="step-banner__column-left">
      <h2 class="step-banner__title mb-12">Ready to take the next step?</h2>
      <div class="step-banner__text">
         Book your personal consultation with Dr. Martin Rachwalski today and
         start your journey towards a refreshed and confident look.
      </div>
   </div>
   <div class="step-banner__column-right">
      <button type="button" data-popup-open="book" class="step-banner__btn btn btn--medium white-btn">
         Book consultation
      </button>
   </div>
</div>
