---
import "@styles/components/section/_section-header.scss";

interface Props {
   class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["section-header", className]}>
   <div class="section-header__left">
      <slot name="left" />
   </div>
   <div class="section-header__right">
      <slot name="right" />
   </div>
</div>
