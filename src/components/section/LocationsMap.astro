---
import "@styles/components/section/_locations-map.scss";
import GoogleMap from "@components/ui/GoogleMap.astro";
import Icon from "@components/ui/Icon.astro";

const markers = [
   {
      lat: 48.87526474042614,
      lng: 2.284605699999509,
      title: "Cabinet Paris 16",
      subtitle: "Clinique Alphand",
      icon: "/img/pin-1.svg",
      url: "https://www.google.com/maps?q=48.87526474042614,2.284605699999509",
   },
   {
      lat: 48.88057839004017,
      lng: 2.3152600577210265,
      title: "Cabinet Paris 08",
      subtitle: "Rachwalski | Facial Surgery",
      icon: "/img/pin-2.svg",
      url: "https://www.google.com/maps?q=48.88057839004017,2.3152600577210265",
   },
];

const center = { lat: 48.8779, lng: 2.2999 };
---

<div class="locations-map">
   <div class="locations-map__container">
      <div class="locations-map__panel br-12">
         <!-- Cabinet Paris 08 -->
         <div class="location-card">
            <div class="location-card__name fw-600 fs-20">Cabinet Paris 08</div>

            <div class="location-card__place">
               <div class="location-card__place-icon">
                  <Icon name="location-icon-1" />
               </div>
               <div class="location-card__place-info">
                  <div class="location-card__clinic fs-14 fw-700">
                     Rachwalski I Facial Surgery
                  </div>
                  <button
                     type="button"
                     class="location-card__address fs-14"
                     data-location-card
                     data-location-index="1"
                     aria-label="Show Cabinet Paris 08 on the map"
                  >
                     101 Rue de Miromesnil,<br />75008 Paris, France
                  </button>
               </div>
            </div>

            <div class="location-card__section fs-14">
               <div class="location-card__label fw-600">Office hours</div>
               <span class="location-card__hours-day">Monday–Friday:</span>
               <span class="location-card__hours-time">10:00 – 21:00</span>
               <span class="location-card__hours-day">Saturday:</span>
               <span class="location-card__hours-time">9:00 – 20:00</span>
            </div>
         </div>

         <!-- Cabinet Paris 16 -->
         <div class="location-card">
            <div class="location-card__name fw-600 fs-20">Cabinet Paris 16</div>

            <div class="location-card__place">
               <div class="location-card__place-icon">
                  <Icon name="location-icon-2" />
               </div>
               <div class="location-card__place-info">
                  <div class="location-card__clinic fs-14 fw-700">
                     Clinique Alphand,
                  </div>
                  <button
                     type="button"
                     class="location-card__address fs-14"
                     data-location-card
                     data-location-index="0"
                     aria-label="Show Cabinet Paris 16 on the map"
                  >
                     23 Rue de Pergolèse,<br />75116 Paris, France
                  </button>
               </div>
            </div>

            <div class="location-card__section fs-14">
               <div class="location-card__label fw-600">Office hours</div>
               <span class="location-card__hours-day">Wednesday:</span>
               <span class="location-card__hours-time">14:00 – 20:00</span>
            </div>
         </div>
      </div>

      <div class="locations-map__map-wrap">
         <GoogleMap {markers} {center} zoom={13} panX={-150} />
      </div>
   </div>
</div>
