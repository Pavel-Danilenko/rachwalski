---
import "@styles/components/section/_locations-map.scss";
import GoogleMap from "@components/ui/GoogleMap.astro";
import Icon from "@components/ui/Icon.astro";

const markers = [
   {
      lat: 48.8752,
      lng: 2.3122,
      title: "Cabinet Paris 08 — Rachwalski Facial Surgery",
      icon: "/img/pin-1.svg",
   },
   {
      lat: 48.8743,
      lng: 2.2803,
      title: "Clinique Alphand — Cabinet Paris 16",
      icon: "/img/pin-2.svg",
   },
];

const center = { lat: 48.875, lng: 2.296 };
---

<div class="locations-map">
   <div class="locations-map__container">
      <div class="locations-map__panel br-12">
         <!-- Cabinet Paris 08 -->
         <div class="location-card">
            <div class="location-card__name fw-600 fs-20">Cabinet Paris 08</div>

            <div class="location-card__place">
               <div class="location-card__place-icon">
                  <Icon name="location-icon-1" />
               </div>
               <div class="location-card__place-info">
                  <div class="location-card__clinic fs-14">
                     Rachwalski I Facial Surgery
                  </div>
                  <a
                     href="https://www.google.com/maps/search/?api=1&query=101+Rue+de+Miromesnil,+75008+Paris,+France"
                     class="location-card__address fs-14"
                     target="_blank"
                     rel="noopener noreferrer"
                     aria-label="Open Cabinet Paris 08 on Google Maps"
                  >
                     101 Rue de Miromesnil,<br />75008 Paris, France
                  </a>
               </div>
            </div>

            <div class="location-card__section">
               <div class="location-card__label fw-600">Office hours</div>
               <div class="location-card__hours fs-14">
                  <span>Mon–Fri: </span><span>10:00 – 21:00</span>
               </div>
               <div class="location-card__hours fs-14">
                  <span>Saturday: </span><span>9:00 – 20:00</span>
               </div>
               <div class="location-card__hours fs-14">
                  <span>Sunday: </span><span>10:00 – 20:00</span>
               </div>
            </div>
         </div>

         <!-- Cabinet Paris 16 -->
         <div class="location-card">
            <div class="location-card__name fw-600 fs-20">Cabinet Paris 16</div>

            <div class="location-card__place">
               <div class="location-card__place-icon">
                  <Icon name="location-icon-2" />
               </div>
               <div class="location-card__place-info">
                  <div class="location-card__clinic fs-14">
                     Clinique Alphand,
                  </div>
                  <a
                     href="https://www.google.com/maps/search/?api=1&query=23+Rue+de+Pergol%C3%A8se,+75116+Paris,+France"
                     class="location-card__address fs-14"
                     target="_blank"
                     rel="noopener noreferrer"
                     aria-label="Open Cabinet Paris 16 on Google Maps"
                  >
                     23 Rue de Pergolèse,<br />75116 Paris, France
                  </a>
               </div>
            </div>

            <div class="location-card__section">
               <div class="location-card__label fw-600">Office hours</div>
               <div class="location-card__hours fs-14">
                  <span>Wednesday: </span><span>14:00 – 20:00</span>
               </div>
            </div>
         </div>
      </div>

      <div class="locations-map__map-wrap">
         <GoogleMap {markers} {center} zoom={13} panX={-150} />
      </div>
   </div>
</div>
