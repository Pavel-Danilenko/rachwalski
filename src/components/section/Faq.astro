---
import Icon from "@components/ui/Icon.astro";
import faqAuthor from "@assets/img/services/rhinoplasty/author-small.png";
import Accordion from "@components/interactive/accordion.astro";
import Img from "@components/media/Img.astro";
import "@styles/components/section/_faq.scss";

interface Props {
   items: {
      question: string;
      answer: string;
   }[];
}

const { items } = Astro.props;
---

<section class="faq">
   <div class="faq__container pt-80 pb-80">
      <h2 class="faq__title mb-40">FAQ - rhinoplasty</h2>
      <div class="faq__row">
         <div class="faq__column-left">
            <div class="faq__detail br-20 glass">
               <div class="faq__author faq-author mb-20">
                  <Img
                     src={faqAuthor}
                     alt="Dr. Martin Rachwalski"
                     width={50}
                     height={50}
                     loading="lazy"
                     wrapperClass="faq-author__img br-12"
                  />
                  <div class="faq-author__description">
                     <div class="faq-author__name fs-24">
                        Dr. Martin Rachwalski
                     </div>
                     <div class="faq-author__text">Facial Surgeon</div>
                  </div>
               </div>
               <div class="faq__author__text fs-32 mb-40">
                  “Have more questions or just curious about future
                  possibilities? Feel free to contact with me”
               </div>
               <div class="faq__social faq-social">
                  <div class="faq-social__row">
                     <a href="#" class="faq-social__link instagram">
                        <Icon name="instagram" />
                     </a>
                     <a href="#" class="faq-social__link linkedin">
                        <Icon name="linkedin" />
                     </a>
                     <a href="#" class="faq-social__link facebook">
                        <Icon name="facebook" />
                     </a>
                     <a href="#" class="faq-social__link twitter">
                        <Icon name="twitter" />
                     </a>
                  </div>
                  <a href="#" data-popup-open="book" class="faq-social__btn btn--medium btn white-btn">
                     Contact us
                  </a>
               </div>
            </div>
         </div>

         <div class="faq__column-right">
            <Accordion
               defaultOpen={[0]}
               duration={350}
               class="faq__accordion faq-accordion"
            >
               {
                  items.map((item) => (
                     <div
                        data-accordion-item
                        class="faq-accordion__item glass br-20"
                     >
                        <button
                           data-accordion-trigger
                           class="fs-20 faq-accordion__btn"
                        >
                           {item.question}
                           <Icon name="arrow-down" />
                        </button>
                        <div data-accordion-content>
                           <div class="faq-accordion__inner">
                              <div class="faq-accordion__body ct-black br-8 fs-16">
                                 {item.answer}
                              </div>
                           </div>
                        </div>
                     </div>
                  ))
               }
            </Accordion>
         </div>
      </div>
   </div>
</section>
