---
import "@styles/components/section/_post-sidebar.scss";

interface TocItem {
   id: string;
   title: string;
}

interface Author {
   name: string;
   avatar: string;
   specialty: string;
}

interface Props {
   toc?: TocItem[];
   author: Author;
}

const { toc = [], author } = Astro.props;
---

<aside class="post-sidebar">
   {toc.length > 0 && (
      <div class="post-sidebar__toc glass br-20" data-toc>
         <div class="post-sidebar__toc-title fs-16 fw-600">Table of contents</div>
         <div class="post-sidebar__toc-list" data-slide-nav>
            {toc.map((item) => (
               <a
                  href={`#${item.id}`}
                  data-goto={`#${item.id}`}
                  class="post-sidebar__toc-link"
               >
                  {item.title}
               </a>
            ))}
            <span class="post-sidebar__toc-indicator" data-slide-indicator></span>
         </div>
      </div>
   )}

   <div class="post-sidebar__subscribe glass br-20">
      <div class="post-sidebar__subscribe-author">
         <div class="post-sidebar__subscribe-avatar">
            <img src={author.avatar} alt={author.name} width={48} height={48} loading="lazy" />
         </div>
         <div class="post-sidebar__subscribe-info">
            <div class="post-sidebar__subscribe-label fs-14">Stay Connected with</div>
            <div class="post-sidebar__subscribe-name fw-600">{author.name}</div>
         </div>
      </div>
      <p class="post-sidebar__subscribe-text fs-14">
         Subscribe to be the first who know about new treatments, expert insights from {author.name}.
      </p>
      <form class="post-sidebar__subscribe-form">
         <input
            type="email"
            class="post-sidebar__subscribe-input"
            placeholder="Enter your email"
         />
         <button type="submit" class="post-sidebar__subscribe-btn btn white-btn">
            Subscribe
         </button>
      </form>
      <p class="post-sidebar__subscribe-policy fs-14">
         We care about your data in our <a href="/privacy-policy">privacy policy</a>.
      </p>
   </div>
</aside>
