---
import "@styles/components/section/_post-sidebar.scss";
import Newsletter from "@components/section/Newsletter.astro";

interface TocItem {
   id: string;
   title: string;
}

interface Author {
   name: string;
   avatar: string;
   specialty: string;
}

interface Props {
   toc?: TocItem[];
   author: Author;
}

const { toc = [], author } = Astro.props;
---

<aside class="post-sidebar">
   {toc.length > 0 && (
      <div class="post-toc glass br-20" data-toc>
         <div class="post-toc__title fs-24 mb-20">Table of contents</div>
         <div class="post-toc__list" data-slide-nav>
            {toc.map((item) => (
               <a
                  href={`#${item.id}`}
                  data-goto={`#${item.id}`}
                  class="post-toc__link"
               >
                  {item.title}
               </a>
            ))}
            <span class="post-toc__indicator" data-slide-indicator></span>
         </div>
      </div>
   )}

   <Newsletter name={author.name} avatar={author.avatar} />
</aside>
