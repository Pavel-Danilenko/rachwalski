---
import "@styles/components/section/_treatments-hotspot.scss";
import Icon from "@components/ui/Icon.astro";
import Img from "@components/media/Img.astro";
import img1 from "@assets/img/main/treatments-img-1.png";
import img2 from "@assets/img/main/treatments-img-2.png";
---

<section class="treatments">
   <div class="treatments__container pb-80 pt-80">

      <!-- Card 1: Aesthetic medicine -->
      <div class="treatments__card treatments__card--1">
         <span class="treatments__label fs-24">Aesthetic medicine</span>
         <div class="treatments__media">
            <Img src={img1} alt="Aesthetic medicine" loading="lazy" />

            <div class="treatments__hotspot" data-hotspot data-side="right" data-x="86" data-y="32" data-y-sm="10">
               <div class="treatments__dot"><span class="treatments__dot-ring"></span></div>
               <div class="treatments__popup">
                  <svg class="treatments__line" viewBox="0 0 280 88" fill="none" aria-hidden="true">
                     <polyline points="26,58 58,10 360,10" stroke="rgba(255,255,255,1)" stroke-width="1" fill="none"/>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="#" class="treatments__link">Surgical nose correction <Icon name="arrow-link-top" /></a>
                     <a href="#" class="treatments__link">Non-surgical nose enhancement <Icon name="arrow-link-top" /></a>
                  </div>
               </div>
            </div>

            <div class="treatments__hotspot" data-hotspot data-side="right" data-x="30" data-y="38">
               <div class="treatments__dot"><span class="treatments__dot-ring"></span></div>
               <div class="treatments__popup">
                  <svg class="treatments__line" viewBox="0 0 280 88" fill="none" aria-hidden="true">
                     <polyline points="26,58 58,10 360,10" stroke="rgba(255,255,255,1)" stroke-width="1" fill="none"/>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="#" class="treatments__link">Link 1 <Icon name="arrow-link-top" /></a>
                     <a href="#" class="treatments__link">Link 2 <Icon name="arrow-link-top" /></a>
                  </div>
               </div>
            </div>

            <div class="treatments__hotspot" data-hotspot data-side="right" data-x="20" data-y="62">
               <div class="treatments__dot"><span class="treatments__dot-ring"></span></div>
               <div class="treatments__popup">
                  <svg class="treatments__line" viewBox="0 0 280 88" fill="none" aria-hidden="true">
                     <polyline points="26,58 58,10 360,10" stroke="rgba(255,255,255,1)" stroke-width="1" fill="none"/>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="#" class="treatments__link">Link 3 <Icon name="arrow-link-top" /></a>
                     <a href="#" class="treatments__link">Link 4 <Icon name="arrow-link-top" /></a>
                  </div>
               </div>
            </div>

            <div class="treatments__hotspot" data-hotspot data-side="right" data-x="55" data-y="78">
               <div class="treatments__dot"><span class="treatments__dot-ring"></span></div>
               <div class="treatments__popup">
                  <svg class="treatments__line" viewBox="0 0 280 88" fill="none" aria-hidden="true">
                     <polyline points="26,58 58,10 360,10" stroke="rgba(255,255,255,1)" stroke-width="1" fill="none"/>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="#" class="treatments__link">Link 5 <Icon name="arrow-link-top" /></a>
                     <a href="#" class="treatments__link">Link 6 <Icon name="arrow-link-top" /></a>
                  </div>
               </div>
            </div>

         </div>
      </div>

      <!-- Card 2: Facial aesthetic surgery -->
      <div class="treatments__card treatments__card--2">
         <span class="treatments__label fs-24">Facial aesthetic surgery</span>
         <div class="treatments__media">
            <Img src={img2} alt="Facial aesthetic surgery" loading="lazy" />

            <div class="treatments__hotspot" data-hotspot data-side="left" data-x="30" data-y="42" data-y-sm="10">
               <div class="treatments__dot"><span class="treatments__dot-ring"></span></div>
               <div class="treatments__popup">
                  <svg class="treatments__line" viewBox="0 0 260 88" fill="none" aria-hidden="true">
                     <polyline points="234,58 202,10 -80,10" stroke="rgba(255,255,255,1)" stroke-width="1" fill="none"/>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="#" class="treatments__link">Botox Injections <Icon name="arrow-link-top" /></a>
                     <a href="#" class="treatments__link">Hyaluronic acid injections <Icon name="arrow-link-top" /></a>
                  </div>
               </div>
            </div>

            <div class="treatments__hotspot" data-hotspot data-side="left" data-x="58" data-y="20">
               <div class="treatments__dot"><span class="treatments__dot-ring"></span></div>
               <div class="treatments__popup">
                  <svg class="treatments__line" viewBox="0 0 260 88" fill="none" aria-hidden="true">
                     <polyline points="234,58 202,10 -80,10" stroke="rgba(255,255,255,1)" stroke-width="1" fill="none"/>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="#" class="treatments__link">Link 7 <Icon name="arrow-link-top" /></a>
                     <a href="#" class="treatments__link">Link 8 <Icon name="arrow-link-top" /></a>
                  </div>
               </div>
            </div>

            <div class="treatments__hotspot" data-hotspot data-side="left" data-x="35" data-y="72">
               <div class="treatments__dot"><span class="treatments__dot-ring"></span></div>
               <div class="treatments__popup">
                  <svg class="treatments__line" viewBox="0 0 260 88" fill="none" aria-hidden="true">
                     <polyline points="234,58 202,10 -80,10" stroke="rgba(255,255,255,1)" stroke-width="1" fill="none"/>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="#" class="treatments__link">Link 9 <Icon name="arrow-link-top" /></a>
                     <a href="#" class="treatments__link">Link 10 <Icon name="arrow-link-top" /></a>
                  </div>
               </div>
            </div>

         </div>
      </div>

   </div>
</section>
