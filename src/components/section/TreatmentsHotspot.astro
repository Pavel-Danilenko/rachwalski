---
import "@styles/components/section/_treatments-hotspot.scss";
import Icon from "@components/ui/Icon.astro";
import Img from "@components/media/Img.astro";
import img1 from "@assets/img/main/treatments-img-1.png";
import img2 from "@assets/img/main/treatments-img-2.png";
---

<section class="treatments">
   <div class="treatments__container pb-80 pt-80">
      <!-- Card 1: Aesthetic medicine -->
      <div class="treatments__card treatments__card--1">
         <a href="/rhinoplasty" class="treatments__label fs-24">
            Facial aesthetic surgery <Icon name="arrow-link-top" />
         </a>
         <div class="treatments__media">
            <Img src={img1} alt="Facial aesthetic surgery" loading="lazy" />

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="86"
               data-y="44"
               data-y-sm="42"
               data-x-sm="84"
            >
               <div class="treatments__dot">
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >Surgical nose correction <Icon
                           name="arrow-link-top"
                        /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link">
                        Non-surgical nose enhancement <Icon
                           name="arrow-link-top"
                        />
                     </a>
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="68"
               data-y="32"
            >
               <div class="treatments__dot">
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >Facelift surgery <Icon name="arrow-link-top" /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link"
                        >Eyelid correction <Icon name="arrow-link-top" /></a
                     >
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="48"
               data-y="36"
            >
               <div class="treatments__dot">
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >Neck lift <Icon name="arrow-link-top" /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link"
                        >Chin augmentation <Icon name="arrow-link-top" /></a
                     >
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="65"
               data-y="74"
            >
               <div class="treatments__dot">
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >Lip augmentation <Icon name="arrow-link-top" /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link"
                        >Cheek fillers <Icon name="arrow-link-top" /></a
                     >
                  </div>
               </div>
            </div>
         </div>
      </div>

      <!-- Card 2: Facial aesthetic surgery -->
      <div class="treatments__card treatments__card--2">
         <a href="/rhinoplasty" class="treatments__label fs-24">
            Aesthetic medicine <Icon name="arrow-link-top" />
         </a>
         <div class="treatments__media">
            <Img src={img2} alt="Aesthetic medicine" loading="lazy" />

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="left"
               data-x="37"
               data-y="60"
               data-y-sm="60"
               data-x-sm="34"
            >
               <div class="treatments__dot">
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 260 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="234"
                        y1="58"
                        x2="202"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >Botox Injections <Icon name="arrow-link-top" /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link"
                        >Hyaluronic acid injections <Icon
                           name="arrow-link-top"
                        /></a
                     >
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="left"
               data-x="58"
               data-y="20"
            >
               <div class="treatments__dot">
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 260 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="234"
                        y1="58"
                        x2="202"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >PRP therapy <Icon name="arrow-link-top" /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link"
                        >Skin rejuvenation <Icon name="arrow-link-top" /></a
                     >
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="left"
               data-x="37"
               data-y="86"
            >
               <div class="treatments__dot">
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 260 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="234"
                        y1="58"
                        x2="202"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >Thread lifting <Icon name="arrow-link-top" /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link"
                        >Mesotherapy <Icon name="arrow-link-top" /></a
                     >
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</section>
