---
import "@styles/components/section/_treatments-hotspot.scss";
import Icon from "@components/ui/Icon.astro";
import Img from "@components/media/Img.astro";
import img1 from "@assets/img/main/treatments-img-1.png";
import img2 from "@assets/img/main/treatments-img-2.png";
---

<section class="treatments">
   <div class="treatments__container pb-80 pt-80">
      <!-- Card 1: Aesthetic medicine -->
      <div class="treatments__card treatments__card--1">
         <a
            href="/rhinoplasty"
            class="treatments__label btn btn--big white-btn btn-24"
         >
            Facial surgery <Icon name="arrow-link-top" />
         </a>
         <div class="treatments__media" data-parallax>
            <Img
               src={img1}
               alt="Facial aesthetic surgery"
               wrapperClass="treatments__img treatments__img-first"
               loading="lazy"
               data-parallax-item
               data-parallax-strength="-6"
               data-parallax-scale="1.02"
            />

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="86"
               data-y="44"
               data-y-sm="42"
               data-x-sm="84"
            >
               <div
                  class="treatments__dot"
                  data-parallax-item
                  data-parallax-strength="10"
               >
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link">
                        Nose Surgery
                        <Icon name="arrow-link-top" />
                     </a>
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="68"
               data-y="32"
            >
               <div
                  class="treatments__dot"
                  data-parallax-item
                  data-parallax-strength="10"
               >
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link">
                        Eyelid and Periorbital Surgery
                        <Icon name="arrow-link-top" />
                     </a>
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="48"
               data-y="36"
            >
               <div
                  class="treatments__dot"
                  data-parallax-item
                  data-parallax-strength="10"
               >
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link">
                        Aesthetic Ear Surgery
                        <Icon name="arrow-link-top" />
                     </a>
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="76"
               data-y="62"
            >
               <div
                  class="treatments__dot"
                  data-parallax-item
                  data-parallax-strength="10"
               >
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link">
                        Chin and Facial Implant Surgery
                        <Icon name="arrow-link-top" />
                     </a>
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="right"
               data-x="49"
               data-y="62"
            >
               <div
                  class="treatments__dot"
                  data-parallax-item
                  data-parallax-strength="10"
               >
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 280 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="26"
                        y1="58"
                        x2="58"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >Facial Rejuvenation &amp; Contouring <Icon
                           name="arrow-link-top"
                        /></a
                     >
                  </div>
               </div>
            </div>
         </div>
      </div>

      <!-- Card 2: Facial aesthetic surgery -->
      <div class="treatments__card treatments__card--2">
         <a
            href="/rhinoplasty"
            class="treatments__label btn btn--big white-btn btn-24"
         >
            Aesthetic medicine <Icon name="arrow-link-top" />
         </a>
         <div class="treatments__media" data-parallax>
            <Img
               src={img2}
               alt="Aesthetic medicine"
               wrapperClass="treatments__img treatments__img-second"
               loading="lazy"
               data-parallax-item
               data-parallax-strength="-6"
               data-parallax-scale="1.02"
            />

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="left"
               data-x="49"
               data-y="36"
            >
               <div
                  class="treatments__dot"
                  data-parallax-item
                  data-parallax-strength="10"
               >
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 260 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="234"
                        y1="58"
                        x2="202"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link"
                        >Botox <Icon name="arrow-link-top" /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link"
                        >Hyaluronic Acid <Icon name="arrow-link-top" /></a
                     >
                     <a href="/rhinoplasty" class="treatments__link"
                        >Collagen Stimulators <Icon name="arrow-link-top" /></a
                     >
                  </div>
               </div>
            </div>

            <div
               class="treatments__hotspot"
               data-hotspot
               data-side="left"
               data-x="39"
               data-y="84"
            >
               <div
                  class="treatments__dot"
                  data-parallax-item
                  data-parallax-strength="10"
               >
                  <span class="treatments__dot-ring"></span>
               </div>
               <div class="treatments__popup">
                  <svg
                     class="treatments__line"
                     viewBox="0 0 260 88"
                     fill="none"
                     aria-hidden="true"
                  >
                     <line
                        x1="234"
                        y1="58"
                        x2="202"
                        y2="10"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1"></line>
                  </svg>
                  <div class="treatments__popup-box">
                     <a href="/rhinoplasty" class="treatments__link">
                        Nose Surgery
                        <Icon name="arrow-link-top" />
                     </a>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</section>
