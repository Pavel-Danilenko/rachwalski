---
import "@styles/components/progress-bar/_progress-bar.scss";

interface Props {
   value: number;
   max?: number;
   variant?: "linear" | "circular";
   size?: "sm" | "md" | "lg";
   color?: string;
   duration?: number;
   easing?:
      | "linear"
      | "ease"
      | "ease-in"
      | "ease-out"
      | "ease-in-out"
      | "bounce"
      | "elastic";
   showValue?: boolean;
   valueFormat?: "percentage" | "fraction";
   striped?: boolean;
   stripedAnimated?: boolean;
   rounded?: boolean;
   class?: string;
   // Прибрали animated prop - юзер сам контролює через data-watch атрибути
}

const {
   value,
   max = 100,
   variant = "linear",
   size = "md",
   color,
   duration = 1,
   easing = "ease-out",
   showValue = false,
   valueFormat = "percentage",
   striped = false,
   stripedAnimated = false,
   rounded = false,
   class: className,
   ...rest // всі data-watch-* атрибути передаються сюди
} = Astro.props;

const percentage = Math.min(Math.max((value / max) * 100, 0), 100);

const displayValue =
   valueFormat === "percentage"
      ? `${Math.round(percentage)}%`
      : `${value}/${max}`;

const inlineStyles = [
   `--progress: ${percentage}%`,
   `--progress-value: ${percentage}`,
   color && `--progress-fill: ${color}`,
   `--progress-duration: ${duration}s`,
   `--progress-easing: ${easing}`,
]
   .filter(Boolean)
   .join("; ");

const circleRadius = 54;
const circleCircumference = 2 * Math.PI * circleRadius;
---

{
   variant === "linear" ? (
      <div class="progress-bar-wrapper">
         <div
            class:list={[
               "progress-bar",
               `progress-bar--${size}`,
               striped && "progress-bar--striped",
               stripedAnimated && "progress-bar--striped-animated",
               rounded && "progress-bar--rounded",
               className,
            ]}
            data-variant={variant}
            data-progress-value={percentage}
            data-progress-max={max}
            data-easing={easing}
            style={inlineStyles}
            {...rest}
         >
            <div class="progress-bar__track">
               <div class="progress-bar__fill">
                  <slot name="label" />
               </div>
            </div>
         </div>

         {showValue && !Astro.slots.has("default") && (
            <span class="progress-bar__value">{displayValue}</span>
         )}

         <slot />
      </div>
   ) : (
      <div
         class:list={["progress-circle", `progress-circle--${size}`, className]}
         data-variant={variant}
         data-progress-value={percentage}
         data-progress-max={max}
         data-easing={easing}
         style={inlineStyles}
         {...rest}
      >
         <svg class="progress-circle__svg" viewBox="0 0 120 120">
            <circle
               class="progress-circle__track"
               cx="60"
               cy="60"
               r={circleRadius}
               fill="none"
            />
            <circle
               class="progress-circle__fill"
               cx="60"
               cy="60"
               r={circleRadius}
               fill="none"
               stroke-dasharray={circleCircumference}
               stroke-dashoffset={circleCircumference}
               style={`--circle-circumference: ${circleCircumference}`}
            />
         </svg>

         <div class="progress-circle__content">
            {showValue && !Astro.slots.has("default") && (
               <span class="progress-circle__value">{displayValue}</span>
            )}
            <slot />
         </div>
      </div>
   )
}

<script>
   import "@scripts/init/progress-bar";
</script>
