                                                   <NavItem
                                                      nav="amRfSecretRf"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="amRfFractional"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                       </div>
                                    </div>
                                 </div>
                              </li>

                              <!-- Fees -->
                              <li class="nav-overlay__item">
                                 <NavItem
                                    nav="fees"
                                    class="nav-overlay__link"
                                 />
                              </li>

                              <!-- Resources -->
                              <li class="nav-overlay__item nav-sub">
                                 <button
                                    class="nav-sub__trigger"
                                    data-menu-dropdown-toggle
                                 >
                                    Resources
                                    <Icon name="nav-arrow" />
                                 </button>
                                 <div
                                    class="nav-sub__row"
                                    data-menu-dropdown
                                    data-show-from="md"
                                 >
                                    <div>
                                       <div class="nav-sub__cols">
                                          <div class="nav-sub__col">
                                             <div class="nav-sub__col-links">
                                                <NavItem
                                                   nav="blog"
                                                   class="nav-sub__link"
                                                />
                                             </div>
                                          </div>
                                       </div>
                                    </div>
                                 </div>
                              </li>
                           </ul>
                        </nav>
                     </div>

                     <!-- Footer bar -->
                     <div class="nav-overlay__footer glass">
                        <div class="nav-overlay__doctor">
                           <Img
                              src={doctorImg}
                              alt="Dr. Martin Rachwalski"
                              wrapperClass="nav-overlay__doctor-img"
                           />
                           <div class="nav-overlay__doctor-info">
                              <span class="nav-overlay__doctor-name"
                                 >Dr. Martin Rachwalski</span
                              >
                              <span class="nav-overlay__doctor-title"
                                 >Facial Surgeon</span
                              >
                           </div>
                        </div>
                        <div class="nav-overlay__footer-actions">
                           <a href="tel:+33187664715" class="nav-overlay__phone"
                              >+33 1 87 66 47 15</a
                           >
                           <NavItem
                              nav="contact"
                              class="btn btn--medium white-btn"
