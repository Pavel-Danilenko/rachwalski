---
import MenuCustom from "@components/menu/MenuCustom.astro";
import NavItem from "@components/menu/NavItem.astro";
import Logo from "@components/ui/Logo.astro";
import Icon from "@components/ui/Icon.astro";
import Img from "@components/media/Img.astro";
import LanguageSwitcher from "@components/ui/LanguageSwitcher.astro";
import "@styles/components/layout/_header.scss";
import "@styles/components/menu/_nav-overlay.scss";
import doctorImg from "@assets/img/services/rhinoplasty/author-small.png";
import navBG from "@assets/img/nav/nav-bg.png";

interface Props {
   class?: string;
   sticky?: boolean;
}

const { class: className = "", sticky = false } = Astro.props;
---

<header class:list={["header", className]}>
   <div class="header__container">
      <Logo href="/" imageSrc="/img/logo.svg" imageAlt="Rachwalski" />

      <div class="header__column-right">
         <LanguageSwitcher
            languages={[
               { code: "EN", label: "English",  href: "#", active: true },
               { code: "FR", label: "Français", href: "#" },
            ]}
         />
         <a
            href="#"
            data-popup-open="book"
            class="header__btn btn btn--medium btn-dark">Book consultation</a
         >

         <MenuCustom>
            <div data-menu-overlay class="nav-overlay">
               <div class="nav-overlay__bg">
                  <Img
                     src={navBG}
                     alt="Hero"
                     loading="eager"
                     fetchpriority="high"
                     decoding="sync"
                     quality={90}
                     wrapperClass="nav-overlay__bg-img"
                  />
               </div>
               <div class="nav-overlay__body">
                  <!-- Content -->
                  <div class="nav-overlay__container">
                     <div class="nav-overlay__body">
                        <!-- Left: primary nav -->
                        <nav
                           class="nav-overlay__primary glass br-12"
                           aria-label="Main navigation"
                        >
                           <ul class="nav-overlay__list">
                              <!-- Dr. Rachwalski -->
                              <li class="nav-overlay__item nav-sub">
                                 <button
                                    class="nav-sub__trigger"
                                    data-menu-dropdown-toggle
                                 >
                                    Dr. Rachwalski
                                    <Icon name="nav-arrow" />
                                 </button>

                                 <div
                                    class="nav-sub__row"
                                    data-menu-dropdown
                                    data-show-from="md"
                                 >
                                    <div>
                                       <div class="nav-sub__cols">
                                          <div class="nav-sub__col">
                                             <div class="nav-sub__col-links">
                                                <NavItem
                                                   nav="alphabet"
                                                   class="nav-sub__link"
                                                />
                                                <NavItem
                                                   nav="biography"
                                                   class="nav-sub__link"
                                                />
                                                <NavItem
                                                   nav="consultationLocations"
                                                   class="nav-sub__link"
                                                />
                                                <NavItem
                                                   nav="clinicAlphand"
                                                   class="nav-sub__link"
                                                />
                                                <NavItem
                                                   nav="testimonials"
                                                   class="nav-sub__link"
                                                />
                                                <NavItem
                                                   nav="contact"
                                                   class="nav-sub__link"
                                                />
                                                <NavItem
                                                   nav="facialAssessment"
                                                   class="nav-sub__link"
                                                />
                                             </div>
                                          </div>
                                       </div>
                                    </div>
                                 </div>
                              </li>

                              <!-- Facial Assessment -->
                              <li class="nav-overlay__item nav-sub">
                                 <button
                                    class="nav-sub__trigger"
                                    data-menu-dropdown-toggle
                                 >
                                    Facial Assessment
                                    <Icon name="nav-arrow" />
                                 </button>
                                 <div
                                    class="nav-sub__row"
                                    data-menu-dropdown
                                    data-show-from="md"
                                 >
                                    <div>
                                       <div class="nav-sub__cols">
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Upper Face</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="faUpperForeheadAnalysis"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faUpperBrowAssessment"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faUpperEyelidEvaluation"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Mid-Face</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="faMidCheekAssessment"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faMidNasalEvaluation"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Lower Face</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="faLowerJawline"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faLowerChin"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faLowerLip"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faLowerNeck"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Other Areas</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="faOtherEar"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faOtherSkin"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faOtherHarmony"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="faOtherSymmetry"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                       </div>
                                    </div>
                                 </div>
                              </li>

                              <!-- Facial Surgery -->
                              <li class="nav-overlay__item nav-sub">
                                 <button
                                    class="nav-sub__trigger"
                                    data-menu-dropdown-toggle
                                 >
                                    Facial Surgery
                                    <Icon name="nav-arrow" />
                                 </button>
                                 <div
                                    class="nav-sub__row"
                                    data-menu-dropdown
                                    data-show-from="md"
                                 >
                                    <div>
                                       <div class="nav-sub__cols">
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Nose</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="fsNoseRhinoplasty"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="fsNoseSeptoplasty"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="fsNoseTipRefinement"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Ears</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="fsEarsOtoplasty"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="fsEarsEarlobeRepair"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Eyelids</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="fsEyelidsUpper"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="fsEyelidsLower"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="fsEyelidsPtosis"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Face &amp; Neck</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="fsFaceNeckFacelift"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="fsFaceNeckNecklift"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="fsFaceNeckBrowLift"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                       </div>
                                    </div>
                                 </div>
                              </li>

                              <!-- Aesthetic Medicine -->
                              <li class="nav-overlay__item nav-sub">
                                 <button
                                    class="nav-sub__trigger"
                                    data-menu-dropdown-toggle
                                 >
                                    Aesthetic Medicine
                                    <Icon name="nav-arrow" />
                                 </button>
                                 <div
                                    class="nav-sub__row"
                                    data-menu-dropdown
                                    data-show-from="md"
                                 >
                                    <div>
                                       <div class="nav-sub__cols">
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Botox</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="amBotoxForehead"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="amBotoxCrowsFeet"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="amBotoxGlabellar"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Hyaluronic Acid</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="amHaLipFiller"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="amHaCheekAugmentation"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="amHaNasolabial"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Collagen Stimulators & Skin Booster</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="amCollagenSculptra"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="amCollagenRadiesse"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   <NavItem
                                                      nav="amCollagenProfhilo"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
                                                   />
                                                   </div>
                                                </div>
                                             </div>
                                          </div>
                                          <div class="nav-sub__col">
                                             <button
                                                class="nav-sub__col-title"
                                                data-menu-dropdown-toggle
                                                >Radiofrequency</button
                                             >
                                             <div
                                                class="nav-sub__col-links"
                                                data-menu-dropdown
                                                data-show-from="md"
                                             >
                                                <div>
                                                   <div class="nav-sub__col-links__inner">
                                                   <NavItem
                                                      nav="amRfMorpheus"
                                                      class="nav-sub__link"
                                                      data-nav-placeholder
