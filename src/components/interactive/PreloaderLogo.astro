---
import "@styles/components/interactive/_preloader-logo.scss";
import { Picture } from "astro:assets";
import bgFullHd from "@assets/img/preloader/Bg_fullHd.png";
import bgStory from "@assets/img/preloader/Bg_Story.png";

interface Props {
   /** Момент старту колапсу ромбів від початку анімації (мс) */
   collapseAt?: number;
   /** Момент, коли ромб пливе в центр і зменшується до клітинки патерну (мс) */
   dockAt?: number;
   /** Тривалість переїзду ромба в центр (мс) */
   dockDuration?: number;
   /** Масштаб ромба після докінгу (= розмір клітинки патерну) */
   dockScale?: number;
   /** Момент, коли гасне заливка ромба і проявляється паличка (мс) */
   legAt?: number;
   /** Момент старту домальовування R від початку анімації (мс) */
   drawAt?: number;
   /** Тривалість появи/зникнення кожного ромба (мс) */
   petalDuration?: number;
   /** Базовий крок хаотичної появи ромбів (мс); джиттер +0–70% зверху */
   petalStep?: number;
   /** Момент старту кругової хвилі фонового патерну (мс) */
   waveAt?: number;
   /** Тривалість розгортання хвилі патерну (мс) */
   waveDuration?: number;
   /** Тривалість розпилення контуру останнього ромба (мс) */
   dissolveDuration?: number;
   /** Сила розпилення (зміщення в юнітах фільтра) */
   dissolveStrength?: number;
   /** Тривалість домальовування R від палички (мс) */
   drawDuration?: number;
   /** Тривалість переїзду знаку на місце в слові (мс) */
   placeDuration?: number;
   /** Масштаб знаку на старті (×) */
   markScale?: number;
   /** Інтервал появи між літерами (мс) */
   letterInterval?: number;
   /** Тривалість плавної появи кожної літери (мс) */
   letterDuration?: number;
   /** Тривалість затухання прелоудера (мс) */
   fadeDuration?: number;
   /** Мінімальний час показу (мс) */
   minDisplayTime?: number;
   /** Стеля очікування window.load (мс) */
   maxWait?: number;
}

const {
   collapseAt = 1150,
   dockAt = 1500,
   dockDuration = 650,
   dockScale = 1.5,
   legAt = 2450,
   drawAt = 2950,
   petalDuration = 600,
   petalStep = 120,
   waveAt = 2050,
   waveDuration = 1100,
   dissolveDuration = 800,
   dissolveStrength = 90,
   drawDuration = 1500,
   placeDuration = 1000,
   markScale = 2.5,
   letterInterval = 60,
   letterDuration = 1000,
   fadeDuration = 600,
   minDisplayTime = 0,
   maxWait = 8000,
} = Astro.props;

// ── Фоновий патерн: тайл сітки з контуру нижнього ромба знаку ────────────────
// Латтіса патерну = латтіса самого знаку: крок 329.767×192.28 (відстані між
// центрами ромбів у logo-mark), зсув пів-кроку. JS (preloader-logo.js) міряє
// реальний екранний прямокутник нижнього ромба і вирівнює сітку піксель-в-піксель.
const DIA_D =
   "M186.888 294.503C196.652 308.819 206.416 322.982 215.87 337.452C221.759 346.535 229.819 351.923 240.513 353.924C241.443 354.078 242.217 354.232 243.147 354.232C246.247 354.694 249.502 355.002 252.601 355.002C253.066 355.002 253.531 355.002 253.996 355.002L287.473 355.002C287.938 355.002 288.403 355.002 288.868 355.002C291.967 355.002 295.222 354.694 298.322 354.232C299.252 354.078 300.027 353.924 300.957 353.924C311.65 352.077 319.71 346.535 325.599 337.453C335.053 322.982 344.817 308.819 354.581 294.503C359.076 287.883 368.22 278.954 375.969 273.72C368.22 268.486 359.231 259.558 354.581 252.938C344.817 238.621 335.208 224.459 325.599 209.988C319.71 200.905 311.65 195.517 300.957 193.516C300.027 193.362 299.252 193.208 298.322 193.054C295.222 192.593 291.967 192.285 288.868 192.285L252.446 192.285C249.347 192.285 246.092 192.593 242.992 193.054C242.062 193.208 241.288 193.362 240.358 193.516C229.819 195.364 221.605 200.905 215.715 209.988C206.261 224.459 196.497 238.621 186.733 252.938C182.238 259.558 173.094 268.486 165.345 273.72C173.249 278.954 182.238 287.729 186.888 294.503ZM217.11 273.72C217.11 267.717 220.055 260.943 224.084 254.939C234.158 239.545 244.542 224.305 254.461 208.91C257.096 204.754 260.351 201.213 264.07 198.75C267.945 196.287 273.059 196.287 277.089 198.75C280.809 201.059 283.908 204.754 286.698 208.91C296.772 224.305 307.001 239.545 317.075 254.939C321.105 260.943 323.894 267.717 324.049 273.72C324.049 279.57 321.105 286.498 317.075 292.501C307.001 307.896 296.617 323.136 286.698 338.53C284.063 342.687 280.809 346.227 277.089 348.69C273.214 351.153 268.1 351.153 264.07 348.69C260.351 346.381 257.251 342.687 254.461 338.53C244.387 323.136 234.158 307.896 224.084 292.501C220.055 286.344 217.11 279.57 217.11 273.72Z";
const TILE_W = 329.767, TILE_H = 192.28; // періоди латтіси (координати лого)
const tileSvg =
   `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${TILE_W} ${TILE_H}">` +
   `<defs><g id="d" fill="none" stroke="#EFF2F8" stroke-opacity=".22" stroke-width="1.4">` +
   // translate ставить центр ромба (270.657, 273.644) в (0,0)
   `<path transform="translate(-270.657 -273.644)" d="${DIA_D}"/></g></defs>` +
   `<use href="#d"/><use href="#d" x="${TILE_W}"/><use href="#d" y="${TILE_H}"/>` +
   `<use href="#d" x="${TILE_W}" y="${TILE_H}"/><use href="#d" x="${TILE_W / 2}" y="${TILE_H / 2}"/>` +
   `</svg>`;
const patternImg = `url("data:image/svg+xml,${encodeURIComponent(tileSvg)}")`;
---

<div
   class="preloader preloader--logo"
   data-lock
   id="preloader"
   aria-hidden="true"
   style="opacity: 0; visibility: hidden;"
   data-collapse-at={collapseAt}
   data-dock-at={dockAt}
   data-dock-duration={dockDuration}
   data-dock-scale={dockScale}
   data-leg-at={legAt}
   data-draw-at={drawAt}
   data-petal-duration={petalDuration}
   data-petal-step={petalStep}
   data-wave-at={waveAt}
   data-wave-duration={waveDuration}
   data-dissolve-duration={dissolveDuration}
   data-dissolve-strength={dissolveStrength}
   data-draw-duration={drawDuration}
   data-place-duration={placeDuration}
   data-mark-scale={markScale}
   data-letter-interval={letterInterval}
   data-letter-duration={letterDuration}
   data-fade-duration={fadeDuration}
   data-min-display-time={minDisplayTime}
   data-max-wait={maxWait}
>
   <Picture
      src={bgFullHd} alt="" formats={["webp", "png"]}
      widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high"
      class="preloader__bg preloader__bg--desktop"
   />
   <Picture
      src={bgStory} alt="" formats={["webp", "png"]}
      widths={[390, 768, 1200]} sizes="100vw" loading="eager" fetchpriority="high"
      class="preloader__bg preloader__bg--mobile"
   />

   <div
      class="preloader__pattern"
      style={`--pattern-img: ${patternImg}`}
      aria-hidden="true"
   >
   </div>

   <div class="preloader__stage">
      <svg class="preloader__logo" viewBox="0 0 214 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
         <defs>
            <!-- Розпилення контуру ромба: шум зміщує пікселі, scale анімує JS (0 → ~90) -->
            <filter id="preloader-dissolve" x="-40%" y="-40%" width="180%" height="180%" color-interpolation-filters="sRGB">
               <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="3" result="noise" />
               <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
            </filter>
         </defs>
