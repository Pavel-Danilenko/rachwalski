---
import "@styles/components/interactive/_preloader-logo.scss";
import { Picture } from "astro:assets";
import bgFullHd from "@assets/img/preloader/Bg_fullHd.png";
import bgStory from "@assets/img/preloader/Bg_Story.png";

interface Props {
   /** Тривалість морфу ромб→R (мс) */
   morphDuration?: number;
   /** Масштаб знаку на старті (×) */
   markScale?: number;
   /** Інтервал появи між літерами (мс) */
   letterInterval?: number;
   /** Тривалість плавної появи кожної літери (мс) */
   letterDuration?: number;
   /** Тривалість затухання прелоудера (мс) */
   fadeDuration?: number;
   /** Мінімальний час показу (мс) */
   minDisplayTime?: number;
   /** Стеля очікування window.load (мс) */
   maxWait?: number;
}

const {
   morphDuration = 1500,
   markScale = 2.5,
   letterInterval = 60,
   letterDuration = 1000,
   fadeDuration = 600,
   minDisplayTime = 0,
   maxWait = 8000,
} = Astro.props;
---

<div
   class="preloader preloader--logo"
   data-lock
   id="preloader"
   aria-hidden="true"
   style="opacity: 0; visibility: hidden;"
   data-morph-duration={morphDuration}
   data-mark-scale={markScale}
   data-letter-interval={letterInterval}
   data-letter-duration={letterDuration}
   data-fade-duration={fadeDuration}
   data-min-display-time={minDisplayTime}
   data-max-wait={maxWait}
>
   <Picture
      src={bgFullHd} alt="" formats={["webp", "png"]}
      widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high"
      class="preloader__bg preloader__bg--desktop"
   />
   <Picture
      src={bgStory} alt="" formats={["webp", "png"]}
      widths={[390, 768, 1200]} sizes="100vw" loading="eager" fetchpriority="high"
      class="preloader__bg preloader__bg--mobile"
   />

   <div class="preloader__stage">
