---
import "@styles/components/interactive/_preloader.scss";
import { Picture } from "astro:assets";
import bgFullHd from "@assets/img/preloader/Bg_fullHd.png";
import bgStory from "@assets/img/preloader/Bg_Story.png";

interface Props {
   fadeDuration?: number;
   minDisplayTime?: number;
}

const {
   fadeDuration = 600,
   minDisplayTime = 0,
} = Astro.props;
---

<div
   class="preloader"
   data-lock
   id="preloader"
   aria-hidden="true"
   style="opacity: 0; visibility: hidden;"
   data-fade-duration={fadeDuration}
   data-min-display-time={minDisplayTime}
>
   <Picture
      src={bgFullHd}
      alt=""
      formats={["webp", "png"]}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="preloader__bg preloader__bg--desktop"
   />
   <Picture
      src={bgStory}
      alt=""
      formats={["webp", "png"]}
      widths={[390, 768, 1200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="preloader__bg preloader__bg--mobile"
   />
   <div class="preloader__lottie" id="preloaderLottie"></div>
</div>
<script is:inline>
   (function () {
      if (!sessionStorage.getItem("preloader_shown")) {
         sessionStorage.setItem("preloader_shown", "true");
         var el = document.getElementById("preloader");
         if (el) el.style.cssText = "opacity:1;visibility:visible";
      }
   })();
</script>
<script>
   import "@scripts/init/preloader";
</script>
