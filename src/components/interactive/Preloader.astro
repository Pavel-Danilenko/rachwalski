---
// Preloader.astro
import "@styles/components/interactive/_preloader.scss";

interface Props {
   // Затримка перед зникненням після завантаження сторінки (мс)
   hideDelay?: number;
   // Тривалість fade out анімації (мс)
   fadeDuration?: number;
   // Мінімальний час показу прелоадера (мс)
   minDisplayTime?: number;
   // Час за який лічильник доходить до 90% (мс) — імітація швидкості завантаження
   simulationDuration?: number;
   // Логотип — текст або зображення (необов'язково)
   logoText?: string;
   logoSrc?: string;
   logoAlt?: string;
}

const {
   hideDelay = 500,
   fadeDuration = 600,
   minDisplayTime = 0,
   simulationDuration = 800,
   logoText,
   logoSrc,
   logoAlt = "Logo",
} = Astro.props;
---

<div
   class="preloader"
   data-lock
   id="preloader"
   aria-hidden="true"
   style="opacity: 0; visibility: hidden;"
   data-hide-delay={hideDelay}
   data-fade-duration={fadeDuration}
   data-min-display-time={minDisplayTime}
   data-simulation-duration={simulationDuration}
>
   {(logoSrc || logoText) && (
      <div class="preloader__logo">
         {logoSrc
            ? <img src={logoSrc} alt={logoAlt} class="preloader__logo-img" />
            : <span class="preloader__logo-text">{logoText}</span>
         }
      </div>
   )}
   <div class="preloader__counter">
      <span class="preloader__number" id="preloaderNumber">0</span>
      <span class="preloader__percent">%</span>
   </div>
   <div class="preloader__bar">
      <div class="preloader__bar-fill" id="preloaderBar"></div>
   </div>
</div>
<script>
   import "@scripts/init/preloader";
</script>
