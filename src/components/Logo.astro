---
// src/components/Logo.astro

interface Props {
   class?: string;
   text?: string;
   imageSrc?: string;
   imageAlt?: string;
   href?: string;
   target?: "_blank" | "_self";
   forceLink?: boolean;
   "sf-logo"?: string; // для Shopify
}

const {
   class: className,
   text,
   imageSrc,
   imageAlt = "Logo",
   href = "/",
   target = "_self",
   forceLink = false,
   "sf-logo": sfLogo,
} = Astro.props;

const isHomePage = Astro.url.pathname === "/";
const shouldBeLink = !isHomePage || forceLink || href !== "/";
const Tag = shouldBeLink ? "a" : "div";

const linkProps = shouldBeLink
   ? {
        href,
        target,
        ...(target === "_blank" ? { rel: "noopener noreferrer" } : {}),
     }
   : {};

// Передаємо sf-logo на елемент тільки якщо є
const sfProps = sfLogo ? { "sf-logo": sfLogo } : {};
---

<Tag {...linkProps} {...sfProps} class:list={["logo", className]}>
   {
      imageSrc ? (
         <img src={imageSrc} alt={imageAlt} class="logo__image" />
      ) : text ? (
         <span class="logo__text">{text}</span>
      ) : (
         <slot />
      )
   }
</Tag>

<style lang="scss">
   .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;

      &[href] {
         text-decoration: none;
         color: inherit;
         cursor: pointer;
         transition: opacity 0.2s;

         &:hover {
            opacity: 0.8;
         }
      }
   }

   .logo__image {
      display: block;
      height: 40px;
      width: auto;
   }

   .logo__text {
      font-size: 24px;
      font-weight: 700;
      line-height: 1;
   }
</style>
