---
/**
 * FilterTabs — таби-фільтри з ковзаючим індикатором
 * На відміну від Tabs — не перемикає панелі, тільки диспатчить filter:change подію.
 *
 * @param {Array}  tabs        - масив табів: [{ key: "all", label: "View all" }, ...]
 * @param {string} defaultTab  - ключ активного табу за замовчуванням (дефолт: перший)
 * @param {string} class       - додатковий клас на обгортці
 *
 * Подія: filter:change → { detail: { tab: "surgical" } }
 *
 * Приклад:
 * <FilterTabs
 *   tabs={[
 *     { key: "all", label: "View all" },
 *     { key: "surgical", label: "Surgical" },
 *     { key: "non-surgical", label: "Non-surgical" },
 *   ]}
 *   defaultTab="all"
 * />
 *
 * Слухати подію:
 * document.querySelector("[data-filter-tabs]").addEventListener("filter:change", (e) => {
 *   console.log(e.detail.tab); // "surgical"
 * });
 */

import "@styles/components/ui/_filter-tabs.scss";

interface Props {
   tabs: { key: string; label: string }[];
   defaultTab?: string;
   class?: string;
}

const {
   tabs,
   defaultTab = tabs[0]?.key,
   class: className = "",
} = Astro.props;
---

<div
   class:list={["filter-tabs", className]}
   data-filter-tabs
   data-default-tab={defaultTab}
>
   <div class="filter-tabs__nav">
      {
         tabs.map((tab) => (
            <button
               class:list={["filter-tabs__btn", { "is-active": tab.key === defaultTab }]}
               data-filter-tab={tab.key}
               type="button"
               aria-pressed={tab.key === defaultTab ? "true" : "false"}
            >
               {tab.label}
            </button>
         ))
      }
      <div class="filter-tabs__indicator" aria-hidden="true" />
   </div>
</div>
