---
/**
 * Counter - компонент для анімації підрахунку чисел
 * Автоматично інтегрується з data-watch для запуску при скролі
 *
 * @param {number} target - Кінцеве число (обов'язковий параметр)
 * @param {number} start - Початкове число (за замовчуванням 0)
 * @param {number} duration - Тривалість анімації в мс (за замовчуванням 2000)
 * @param {boolean} once - Один раз чи багато разів при скролі (за замовчуванням true)
 *
 * Форматування (пріоритет 1 - locale):
 * @param {string} locale - Локаль для форматування ("en-US", "uk-UA", "de-DE")
 * @param {number} decimals - Кількість десяткових знаків
 *
 * Форматування (пріоритет 2 - ручне):
 * @param {string} thousands - Розділювач тисяч (",", ".", " ", "")
 * @param {string} decimal - Розділювач десяткових ("." або ",")
 *
 * Додатки:
 * @param {string} prefix - Префікс перед числом ("$", "₴", "€")
 * @param {string} suffix - Суфікс після числа ("+", "%", "K")
 *
 * Поведінка:
 * @param {string} easing - Тип анімації ("linear", "ease-in", "ease-out", "ease-in-out")
 *
 * Data-watch налаштування:
 * @param {string} watchMargin - Відступ для trigger (наприклад: "0px", "100px", "-50px")
 * @param {number} watchThreshold - Скільки % елемента має бути видно (0.0 - 1.0)
 * @param {number} watchDelay - Затримка перед запуском в мс
 * @param {string} watchClass - Кастомний клас замість "_watcher-view"
 *
 * Інше:
 * @param {string} class - Додаткові CSS класи
 *
 * Приклади використання:
 * <Counter target={1000} suffix="+" />
 * <Counter target={5000} locale="uk-UA" prefix="₴" />
 * <Counter target={100} suffix="%" duration={3000} easing="ease-in" />
 * <Counter target={1000} once={false} /> <!-- Багаторазова анімація -->
 * <Counter target={10000} short decimals={0} once={false} suffix="+"/>
 * short скорочує великі числа
 */

const {
   // Основні параметри
   target,
   start = 0,
   duration = 2000,
   once = true,

   // Форматування (locale)
   locale,
   decimals,

   // Форматування (ручне)
   thousands,
   decimal,

   // Форматування (short)
   short = false,

   // Додатки
   prefix = "",
   suffix = "",

   // Анімація
   easing = "ease-out",

   // Data-watch налаштування
   watchMargin,
   watchThreshold,
   watchDelay,
   watchClass,

   // CSS
   class: className = "",

   // Інші атрибути
   ...rest
} = Astro.props;

// Валідація обов'язкового параметра
if (target === undefined) {
   throw new Error('Counter component requires "target" prop');
}

// Формуємо об'єкт атрибутів для data-watch
const watchAttrs = once ? { "data-watch-once": "" } : { "data-watch": "" };

// Додаємо опціональні data-watch атрибути
const optionalWatchAttrs: Record<string, string> = {};
if (watchMargin !== undefined)
   optionalWatchAttrs["data-watch-margin"] = watchMargin;
if (watchThreshold !== undefined)
   optionalWatchAttrs["data-watch-threshold"] = String(watchThreshold);
if (watchDelay !== undefined)
   optionalWatchAttrs["data-watch-delay"] = String(watchDelay);
if (watchClass !== undefined)
   optionalWatchAttrs["data-watch-class"] = watchClass;

// Формуємо об'єкт атрибутів для counter
const counterAttrs: Record<string, string> = {
   "data-counter-target": String(target),
   "data-counter-start": String(start),
   "data-counter-duration": String(duration),
   "data-counter-easing": easing,
};

// Додаємо опціональні counter атрибути
if (locale !== undefined) counterAttrs["data-counter-locale"] = locale;
if (decimals !== undefined)
   counterAttrs["data-counter-decimals"] = String(decimals);
if (thousands !== undefined) counterAttrs["data-counter-thousands"] = thousands;
if (decimal !== undefined) counterAttrs["data-counter-decimal"] = decimal;
if (short) counterAttrs["data-counter-short"] = "true";
if (prefix) counterAttrs["data-counter-prefix"] = prefix;
if (suffix) counterAttrs["data-counter-suffix"] = suffix;
---

<div
   class={`counter ${className}`}
   {...watchAttrs}
   {...optionalWatchAttrs}
   {...counterAttrs}
   {...rest}
>
   {start}
</div>
