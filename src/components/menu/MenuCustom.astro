---
// src/components/menu/MenuCustom.astro
import "@styles/components/_menu-custom.scss";

interface Props {
   class?: string;
   closeOthers?: boolean;
}

const { class: className, closeOthers = false } = Astro.props;
---

<nav
   class:list={["menu-custom", className]}
   data-menu
   data-menu-close-others={closeOthers || undefined}
>
   <!-- Бургер -->
   <button
      class="menu-custom__burger"
      data-menu-trigger
      aria-label="Toggle menu"
      type="button"
   >
      <span></span>
      <span></span>
      <span></span>
   </button>

   <!-- Весь контент меню (повна свобода!) -->
   <slot />
</nav>

<script>
   import "@scripts/init/menu";
   import "@scripts/init/menu-active-links";
</script>
