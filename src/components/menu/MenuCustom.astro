---
import "@styles/components/menu/_menu-custom.scss";

interface Props {
   class?: string;
   closeOthers?: boolean;
   burgerLabel?: string;
}

const {
   class: className,
   closeOthers = false,
   burgerLabel = "Відкрити меню",
} = Astro.props;
---

<nav
   class:list={["menu-custom", className]}
   data-menu
   data-menu-close-others={closeOthers || undefined}
   aria-label="Головна навігація"
>
   <button
      class="menu-custom__burger"
      data-menu-trigger
      aria-label={burgerLabel}
      aria-expanded="false"
      aria-controls="menu-overlay"
      type="button"
   >
      <span></span>
      <span></span>
      <span></span>
   </button>

   <slot />
</nav>

<script>
   import "@scripts/init/menu";
   import "@scripts/init/menu-active-links";
</script>
