---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageMain from "@components/ui/PageMain.astro";
import Icon from "@components/ui/Icon.astro";
import Counter from "@components/ui/Counter.astro";
import ShowMoreText from "@components/ui/ShowMoreText.astro";
import Showmore from "@components/pagination/Showmore.astro";
import LectureSlider from "@components/sliders/LectureSlider.astro";
import "@styles/pages/_biography.scss";
import "@styles/components/sliders/_topics-slider.scss";
import Img from "@components/media/Img.astro";
import booHeroImg from "@assets/img/biography/martin.png";
import bioJournal1 from "@assets/img/biography/bio-journal-img-1.png";
import bioJournal2 from "@assets/img/biography/bio-journal-img-2.jpg";
import bookImg1 from "@assets/img/biography/book-img-1.jpg";
import bookImg2 from "@assets/img/biography/book-img-2.jpg";
import footerBg from "@assets/img/footer/footer-bg-3.png";
import StepBanner from "@/components/section/StepBanner.astro";
import ResponsiveImg from "@components/media/ResponsiveImg.astro";
import imgDesktop from "@assets/img/other/bg.jpg";
import imgMobile from "@assets/img/other/mobile-gradient.jpg";
---

<BaseLayout
   title="Biography | Dr. Martin Rachwalski"
   description="Dr. Martin Rachwalski — triple certified Facial Surgeon in Paris"
   footerBg={footerBg}
>
   <PageMain>
      <section class="bio-hero hero-circle">
         <ResponsiveImg
            srcDesktop={imgDesktop}
            srcMobile={imgMobile}
            alt="Hero"
            wrapperClass="hero-gradient__bg hero-gradient__bg--height-100"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            quality={90}
         />

         <div class="bio-hero__container pt-180 pb-80">
            <div class="bio-hero__column-left glass br-12">
               <Img
                  src={booHeroImg}
                  alt="Hero"
                  loading="eager"
                  fetchpriority="high"
                  decoding="sync"
                  quality={90}
                  wrapperClass="bio-hero__img"
               />
            </div>
            <div class="bio-hero__column-right">
               <div class="bio-hero__card br-12 glass">
                  <h1 class="bio-hero__name">Dr. Martin Rachwalski</h1>
                  <div class="bio-hero__desc fs-24">
                     Dr. Martin Rachwalski is a triple certified Facial Surgeon
                     (Maxillofacial Surgery, Head Neck Surgery, Facial Plastic
                     Surgery) with a special clinical and research interest in
                     Facial Plastic Surgery, Cleft Lip and Palate and
                     Craniofacial Anomalies.
                  </div>

                  <div class="bio-hero__body">
                     <div
                        class="bio-hero__stat bio-hero__stat--experience br-12"
                     >
                        <Counter
                           class="bio-hero__stat-value"
                           target={13}
                           suffix="+"
                           duration={1800}
                        />
                        <span class="bio-hero__stat-label fs-16"
                           >Years Experience</span
                        >
                     </div>
                     <div
                        class="bio-hero__stat bio-hero__stat--publications br-12"
                     >
                        <Counter
                           class="bio-hero__stat-value"
                           target={100}
                           suffix="+"
                           duration={2000}
                        />
                        <span class="bio-hero__stat-label fs-16"
                           >Publications</span
                        >
                     </div>
                     <div
                        class="bio-hero__stat bio-hero__stat--satisfaction br-12"
                     >
                        <Counter
                           class="bio-hero__stat-value"
                           target={95}
                           suffix="%"
                           duration={2200}
                        />
                        <span class="bio-hero__stat-label fs-16">Text</span>
                     </div>
                     <div
                        class="bio-hero__location bio-hero__location--main br-12"
                     >
                        <span class="bio-hero__location-label fs-14"
                           >Main consultation location:</span
                        >
                        <div class="bio-hero__location-item">
                           <div class="bio-hero__location-icon">
                              <Icon name="location-icon-1" />
                           </div>
                           <div class="fs-14">
                              <div class="bio-hero__location-clinic fw-700">
                                 Rachwalski | Facial Surgery
                              </div>
                              <a
                                 href="https://maps.app.goo.gl/XV8vyo38gAWYk5Hn9"
                                 class="bio-hero__location-link"
                                 target="_blank"
                                 rel="noopener noreferrer"
                                 aria-label="Open Cabinet Paris 08 on Google Maps"
                              >
                                 101 Rue de Miromesnil,<br />75008 Paris, France
                              </a>
                           </div>
                        </div>
                     </div>
                     <div
                        class="bio-hero__location bio-hero__location--alphand br-12"
                     >
                        <span class="bio-hero__location-label fs-14"
                           >Second consultation location:</span
                        >
                        <div class="bio-hero__location-item">
                           <div class="bio-hero__location-icon">
                              <Icon name="location-icon-2" />
                           </div>
                           <div class="fs-14">
                              <div class="bio-hero__location-clinic fw-700">
                                 Clinique Alphand
                              </div>
                              <a
                                 href="https://maps.app.goo.gl/x2968o4d2hWtNvVr7"
                                 class="bio-hero__location-link"
                                 target="_blank"
                                 rel="noopener noreferrer"
                                 aria-label="Open Cabinet Paris 16 on Google Maps"
                              >
                                 23 Rue de Pergolèse,<br />75116 Paris, France
                              </a>
                           </div>
                        </div>
                     </div>
                  </div>

                  <div class="bio-hero__footer">
                     <div class="bio-hero__socials">
                        <a
                           href="#"
                           class="bio-hero__social"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Instagram"
                        >
                           <Icon name="instagram" />
                        </a>
                        <a
                           href="#"
                           class="bio-hero__social"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="LinkedIn"
                        >
                           <Icon name="linkedin" />
                        </a>
                        <a
                           href="#"
                           class="bio-hero__social"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Facebook"
                        >
                           <Icon name="facebook" />
                        </a>
                        <a
                           href="#"
                           class="bio-hero__social"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="X"
                        >
                           <Icon name="twitter" />
                        </a>
                        <a
                           href="#"
                           class="bio-hero__social"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="YouTube"
                        >
                           <Icon name="youtube" />
                        </a>
                     </div>
                     <button
                        type="button"
                        data-popup-open="book"
                        class="btn btn--medium white-btn"
                        >Book consultation</button
                     >
                  </div>
               </div>
            </div>
         </div>
      </section>

      <section class="bio-biography dark-gradient__top">
         <div class="bio-biography__container pt-80 pb-40">
            <div class="bio-biography__column-left">
               <h2 class="bio-biography__title">Biography</h2>
            </div>
            <div class="bio-biography__column-right">
               <div class="bio-biography__content fs-20">
                  <ShowMoreText
                     lines={4}
                     labelMore="Show more"
                     labelLess="Show less"
                  >
                     Dr. Martin Rachwalski, MD, DDS, FEBOMFS, is a distinguished
                     facial surgeon at Hôpital Armand-Trousseau (AP-HP) in
                     Paris, France.He received his training at the University of
                     Cologne (Germany), University College London (UK), Cornell
                     University, and Johns Hopkins University (USA).From 2008 to
                     2013, he was a research fellow at the Cologne Center for
                     Molecular Medicine (CMMC), and since April 2017, he has
                     been affiliated with the Imagine Institute of Genetic
                     Diseases, Université Paris Descartes–Sorbonne Paris Cité.
                  </ShowMoreText>
               </div>
            </div>
         </div>
      </section>

      <section class="bio-skills bg-white mt-1 light-gradientp-top">
         <div class="bio-skills__container pt-40 pb-40">
            <div class="bio-skills__column-left">
               <h2 class="bio-skills__title ct-black">Skills & expertise</h2>
            </div>
            <div class="bio-skills__column-right">
               <div class="bio-skills__content">
                  <ul class="bio-skills__tags ct-black">
                     <li class="bio-skills__tag bg-white-medium">
                        Facial Plastic Surgery
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Aesthetic Surgery
                     </li>
                     <li class="bio-skills__tag bg-white-medium">Otoplasty</li>
                     <li class="bio-skills__tag bg-white-medium">
                        Blepharoplasty
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Rhinoplasty
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Reconstructive facial procedures
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Cleft Surgery
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Lipofilling (Mircofat and Nanofat)
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Craniofacial Surgery
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Aesthetic Medicine
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Occuloplastic Surgery
                     </li>
                     <li class="bio-skills__tag bg-white-medium">Botox</li>
                     <li class="bio-skills__tag bg-white-medium">
                        Dermal Fillers
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Maxillofacial surgery
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Collagen stimulators
                     </li>
                     <li class="bio-skills__tag bg-white-medium">
                        Radiofrequency
                     </li>
                  </ul>
               </div>
            </div>
         </div>
      </section>

      <section class="bio-memberships bg-white mt-1">
         <div class="bio-memberships__container pt-40 pb-40">
            <div class="bio-memberships__column-left">
               <h2 class="bio-memberships__title ct-black">
                  Professional memberships
               </h2>
            </div>
            <div class="bio-memberships__column-right">
               <div
                  class="bio-memberships__grid cards-slider"
                  data-cards-slider
               >
                  <div class="swiper">
                     <div class="swiper-wrapper">
                        <div
                           class="swiper-slide bio-memberships__item bg-white-medium br-12"
                        >
                           <img
                              src="/img/memberships/memberships-img-1.png"
                              alt="European Association for Cranio Maxillo Facial Surgery"
                              loading="lazy"
                           />
                        </div>
                        <div
                           class="swiper-slide bio-memberships__item bg-white-medium br-12"
                        >
                           <img
                              src="/img/memberships/memberships-img-2.png"
                              alt="EAFPS — The European Academy of Facial Plastic Surgery"
                              loading="lazy"
                           />
                        </div>
                        <div
                           class="swiper-slide bio-memberships__item bg-white-medium br-12"
                        >
                           <img
                              src="/img/memberships/memberships-img-3.png"
                              alt="The Rhinoplasty Society of Europe"
                              loading="lazy"
                           />
                        </div>
                        <div
                           class="swiper-slide bio-memberships__item bg-white-medium br-12"
                        >
                           <img
                              src="/img/memberships/memberships-img-4.png"
                              alt="Aesthetic Multispecialty Society"
                              loading="lazy"
                           />
                        </div>
                        <div
                           class="swiper-slide bio-memberships__item bg-white-medium br-12"
                        >
                           <img
                              src="/img/memberships/memberships-img-5.png"
                              alt="Société Française de Chirurgie Plastique et Esthétique de la Face"
                              loading="lazy"
                           />
                        </div>
                        <div
                           class="swiper-slide bio-memberships__item bg-white-medium br-12"
                        >
                           <img
                              src="/img/memberships/memberships-img-6.svg"
                              alt="Association Française des Chirurgiens de la Face"
                              loading="lazy"
                           />
                        </div>
                     </div>
                  </div>
                  <div class="cards-slider__controls">
                     <button
                        class="slider__arrow slider__arrow--prev"
                        aria-label="Previous"
                     >
                        <Icon name="arrow-dark-slider-left" />
                     </button>
                     <button
                        class="slider__arrow slider__arrow--next"
                        aria-label="Next"
                     >
                        <Icon name="arrow-dark-slider-right" />
                     </button>
                  </div>
               </div>
            </div>
         </div>
      </section>

      <section class="bio-awards bg-white mt-1">
         <div class="bio-awards__container pt-40 pb-40">
            <h2 class="bio-awards__title ct-black mb-40">Honors and awards</h2>
            <div class="bio-awards__row cards-slider" data-cards-slider>
               <div class="swiper">
                  <div class="swiper-wrapper">
                     <div
                        class="swiper-slide bio-awards__item br-12 bg-white-medium"
                     >
                        <div class="bio-awards__img">
                           <img
                              src="/img/memberships/memberships-img-1.png"
                              alt=""
                           />
                        </div>
                        <h3 class="bio-awards__subtitle ct-black">
                           Leibinger Award
                        </h3>
                     </div>
                     <div
                        class="swiper-slide bio-awards__item br-12 bg-white-medium"
                     >
                        <div class="bio-awards__img">
                           <img
                              src="/img/memberships/memberships-img-2.png"
                              alt=""
                           />
                        </div>
                        <h3 class="bio-awards__subtitle ct-black">
                           Hugo Obwegeser Scholarship
                        </h3>
                     </div>
                     <div
                        class="swiper-slide bio-awards__item br-12 bg-white-medium"
                     >
                        <div class="bio-awards__img">
                           <img
                              src="/img/memberships/memberships-img-1.png"
                              alt=""
                           />
                        </div>
                        <h3 class="bio-awards__subtitle ct-black">
                           Professor John Lowry Scholarship
                        </h3>
                     </div>
                     <div
                        class="swiper-slide bio-awards__item br-12 bg-white-medium"
                     >
                        <div class="bio-awards__img">
                           <img
                              src="/img/memberships/memberships-img-3.png"
                              alt=""
                           />
                        </div>
                        <h3 class="bio-awards__subtitle ct-black">
                           European Rhinoplasty Society Fellowship Award
                        </h3>
                     </div>
                     <div
                        class="swiper-slide bio-awards__item br-12 bg-white-medium"
                     >
                        <div class="bio-awards__img">
                           <img
                              src="/img/memberships/memberships-img-7.svg"
                              alt=""
                           />
                        </div>
                        <h3 class="bio-awards__subtitle ct-black">
                           Excellence Scholarship - German Academic Exchange
                           Service
                        </h3>
                     </div>
                     <div
                        class="swiper-slide bio-awards__item br-12 bg-white-medium"
                     >
                        <div class="bio-awards__img">
                           <img
                              src="/img/memberships/memberships-img-8.svg"
                              alt=""
                           />
                        </div>
                        <h3 class="bio-awards__subtitle ct-black">
                           Regan Fellowship Award
                        </h3>
                     </div>
                     <div
                        class="swiper-slide bio-awards__item br-12 bg-white-medium"
                     >
                        <div class="bio-awards__img">
                           <img
                              src="/img/memberships/memberships-img-9.png"
                              alt=""
                           />
                        </div>
                        <h3 class="bio-awards__subtitle ct-black">
                           ERN Craniofacial Fellowship Award EU Commission
                        </h3>
                     </div>
                     <div
                        class="swiper-slide bio-awards__item br-12 bg-white-medium"
                     >
                        <div class="bio-awards__img">
                           <img
                              src="/img/memberships/memberships-img-10.svg"
                              alt=""
                           />
                        </div>
                        <h3 class="bio-awards__subtitle ct-black">
                           International Bone Research Association Scholarship
                        </h3>
                     </div>
                  </div>
               </div>
               <div class="cards-slider__controls">
                  <button
                     class="slider__arrow slider__arrow--prev"
                     aria-label="Previous"
                  >
                     <Icon name="arrow-dark-slider-left" />
                  </button>
                  <button
                     class="slider__arrow slider__arrow--next"
                     aria-label="Next"
                  >
                     <Icon name="arrow-dark-slider-right" />
                  </button>
               </div>
            </div>
         </div>
      </section>

      <section class="bio-board bg-white mt-1">
         <div class="bio-board__container pt-40 pb-80">
            <div class="bio-board__column-left">
               <h2 class="bio-board__title ct-black">Editorial board member</h2>
            </div>
            <div class="bio-board__column-right">
               <div class="bio-board__inner br-12">
                  <Img
                     src={bioJournal1}
                     alt="Опис зображення"
                     loading="lazy"
                     quality={90}
                     wrapperClass="bio-board__img"
                  />
                  <div class="bio-board__description">
                     <h3 class="bio-board__subtitle ct-black">
                        Journal of Cranio-Maxillo-Facial Surgery
                     </h3>
                     <a href="#" class="bio-board__link ct-black">
                        View journal
                        <Icon name="arrow-up" />
                     </a>
                  </div>
               </div>
               <div class="bio-board__inner br-12">
                  <Img
                     src={bioJournal2}
                     alt="Опис зображення"
                     loading="lazy"
                     quality={90}
                     wrapperClass="bio-board__img"
                  />
                  <div class="bio-board__description">
                     <h3 class="bio-board__subtitle ct-black">
                        Journal of Craniofacial Surgery
                     </h3>
                     <a href="#" class="bio-board__link ct-black">
                        View journal
                        <Icon name="arrow-up" />
                     </a>
                  </div>
               </div>
            </div>
         </div>
      </section>

      <section class="bio-media bg-white mt-1">
         <div class="bio-media__container pt-80 pb-20">
            <h2 class="bio-media__title ct-black">
               Dr. Rachwalski in the media
            </h2>
            <Showmore
               perPage={8}
               perPageMd={2}
               itemSelector=".bio-media__item"
               mode="toggle"
               labelToggleOpen="Show more"
               labelToggleClose="Show less"
               icon="arrow-bottom"
               classContent="bio-media__grid"
               classBtn="btn btn--medium btn-show-more black-btn"
               classBtnClose="is-open"
            >
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-1.svg"
                        alt="L'Officiel"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Nanofat : la solution régénérative contre les cernes
                     colorés
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-2.svg"
                        alt="Cosmopolitan"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Comment prolonger les effets du botox pour pouvoir espacer
                     les séances ? Un expert répond
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-3.svg"
                        alt="Voici"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Rides du lapin : comment les faire disparaître, selon un
                     chirurgien esthétique
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-4.svg"
                        alt="Marie France"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Facial harmony and balance: Dr. Rachwalski's philosophy
                     behind every surgical intervention.
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-5.svg"
                        alt="Grazia"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Adieu la peau relâchée : la technique ‘Nefertiti Neck Lift’
                     sculpte la mâchoire et raffermit le cou sans chirurgie
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-6.svg"
                        alt="Madame Figaro"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Tendance beauté coréenne : le "90 degree shoulder", le
                     nouveau standard physique hallucinant
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-7.svg"
                        alt="Marie Claire"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Adieu la peau relâchée : la technique ‘Nefertiti Neck Lift’
                     sculpte la mâchoire et raffermit le cou sans chirurgie
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-8.svg"
                        alt="Parole de Mamans"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Anti-transpirant, traitement contre le bruxisme,
                     migraines...Les différents effets du botox que vous ne
                     soupçonniez pas
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
               <div class="bio-media__item br-12 bg-white-medium">
                  <div class="bio-media__logo">
                     <img
                        src="/img/media/media-1.svg"
                        alt="L'Officiel"
                        loading="lazy"
                     />
                  </div>
                  <div class="bio-media__text ct-black fs-16">
                     Nanofat : la solution régénérative contre les cernes
                     colorés
                  </div>
                  <a href="#" class="bio-media__link ct-black">
                     View publication
                     <Icon name="arrow-up" />
                  </a>
               </div>
            </Showmore>
         </div>
      </section>

      <section class="bio-book bg-white mt-1">
         <div class="bio-book__container pt-20 pb-80">
            <h2 class="bio-book__title ct-black mb-40">
               Research articles and book chapters
            </h2>
            <Showmore
               perPage={2}
               itemSelector=".bio-book__item"
               mode="toggle"
               labelToggleOpen="Show more"
               labelToggleClose="Show less"
               icon="arrow-bottom"
               classContent="bio-book__grid"
               classBtn="btn btn--medium btn-show-more black-btn"
               classBtnClose="is-open"
            >
               <div class="bio-book__item br-12 bg-white-medium">
                  <Img
                     src={bookImg1}
                     alt="Fundamental Concepts in Regenerative Medicine"
