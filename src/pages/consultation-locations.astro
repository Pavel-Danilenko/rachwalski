---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageMain from "@components/ui/PageMain.astro";
import Icon from "@components/ui/Icon.astro";
import "@styles/pages/_consultation-locations.scss";
import SectionHeader from "@components/section/SectionHeader.astro";
import LocationsMap from "@components/section/LocationsMap.astro";
import Faq from "@components/section/Faq.astro";
import footerBg from "@assets/img/footer/footer-bg-5.png";
import ResponsiveImg from "@components/media/ResponsiveImg.astro";
import imgDesktop from "@assets/img/other/bg.jpg";
import imgMobile from "@assets/img/other/mobile-gradient.jpg";

const faqItems = [
   {
      question: "How long is the recovery time after a facelift?",
      answer:
         "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.",
   },
   {
      question: "Who is Dr. Martin Rachwalski?",
      answer: "Lorem ipsum...",
   },
   {
      question: "What are his main areas of expertise?",
      answer: "Lorem ipsum...",
   },
   {
      question: "Does he perform aesthetic surgical procedures?",
      answer: "Lorem ipsum...",
   },
   {
      question: "What non-surgical aesthetic treatments are available?",
      answer: "Lorem ipsum...",
   },
   {
      question: "Where are the consultation locations?",
      answer: "Lorem ipsum...",
   },
   {
      question: "What is his academic and research background?",
      answer: "Lorem ipsum...",
   },
   {
      question: "Does he treat complex congenital conditions?",
      answer: "Lorem ipsum...",
   },
   {
      question: "How can I book a consultation?",
      answer: "Lorem ipsum...",
   },
   {
      question: "What is his professional affiliation in France?",
      answer: "Lorem ipsum...",
   },
];
---

<BaseLayout
   title="Consultation Locations"
   footerBg={footerBg}
   description="Find Dr. Martin Rachwalski's consultation locations in Paris"
>
   <PageMain>
      <section class="cl-locations hero-circle">
         <ResponsiveImg
            srcDesktop={imgDesktop}
            srcMobile={imgMobile}
            alt="Hero"
            wrapperClass="hero-gradient__bg hero-gradient__bg--height-100"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            quality={90}
         />
         <div class="cl-locations__container pt-180 pb-80">
            <h1 class="cl-locations__title fs-36 mb-60 t-center">
               Consultation locations
            </h1>
            <div class="cl-locations__row">
               <!-- Cabinet Paris 08 -->
               <div class="cl-card glass br-20">
                  <div class="cl-card__top mb-20">
                     <div class="cl-card__name fs-24 fw-600">
                        Cabinet Paris 08
                     </div>
                     <div class="cl-card__logo">
                        <Icon name="cabinet-logo-1" />
                     </div>
                  </div>

                  <div class="cl-card__address fs-20 border-y mb-20">
                     <Icon name="pin" />
                     <button
                        type="button"
                        class="cl-card__address-link t-balance"
                        data-location-card
                        data-location-index="1"
                        aria-label="Show Cabinet Paris 08 on the map"
                     >
                        101 Rue de Miromesnil, 75008 Paris, France
                     </button>
                  </div>

                  <div class="cl-card__hours-block fs-20">
                     <div class="cl-card__hours-title fw-600">
                        Office hours:
                     </div>
                     <span class="cl-card__hours-day">Monday–Friday:</span>
                     <span class="cl-card__hours-time">10:00 – 21:00</span>
                     <span class="cl-card__hours-day">Saturday:</span>
                     <span class="cl-card__hours-time">9:00 – 20:00</span>
                  </div>

                  <div class="cl-card__actions">
                     <button
                        type="button"
                        data-popup-open="book"
                        class="btn btn--medium white-solid-btn"
                        >Book consultation</button
                     >
                  </div>
               </div>

               <!-- Cabinet Paris 16 -->
               <div class="cl-card glass br-20">
                  <div class="cl-card__top mb-20">
                     <div class="cl-card__name fs-24 fw-600">
                        Cabinet Paris 16
                     </div>
                     <div class="cl-card__logo">
                        <Icon name="cabinet-logo-2" />
                     </div>
                  </div>

                  <div class="cl-card__address fs-20 border-y mb-20">
                     <Icon name="pin" />
                     <button
                        type="button"
                        class="cl-card__address-link t-balance"
                        data-location-card
                        data-location-index="0"
                        aria-label="Show Cabinet Paris 16 on the map"
                     >
                        23 Rue de Pergolèse, 75116 Paris, France
                     </button>
                  </div>

                  <div class="cl-card__hours-block fs-20">
                     <div class="cl-card__hours-title fw-600">
                        Office hours:
                     </div>
                     <span class="cl-card__hours-day">Wednesday:</span>
                     <span class="cl-card__hours-time">14:00 – 20:00</span>
                  </div>

                  <div class="cl-card__actions">
                     <button
                        type="button"
                        data-popup-open="book"
                        class="btn btn--medium white-solid-btn"
                        >Book consultation</button
                     >
                     <a href="#" class="btn btn--medium white-btn"
                        >More Details</a
                     >
                  </div>
               </div>
            </div>
         </div>
      </section>

      <section class="contact-map">
         <div class="contact-map__container mb-40">
            <SectionHeader>
               <h2 slot="left">Your consultation, your convenience</h2>
               <div slot="right">
                  Dr. Martin Rachwalski welcomes patients in multiple locations
                  to make your visit as comfortable as possible.
               </div>
            </SectionHeader>
         </div>
         <LocationsMap />
      </section>

      <Faq items={faqItems} />
   </PageMain>
</BaseLayout>
