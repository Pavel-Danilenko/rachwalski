---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageMain from "@components/PageMain.astro";
import ProductGallery from "@components/sliders/ProductGallery.astro";
import Tabs from "@components/Tabs.astro";
import "@styles/pages/_product-page.scss";
import Image from "@assets/img/main-page/image.jpg";
---

<BaseLayout title="Product" description="Сторінка товару">
   <PageMain sf-template="product">
      <section sf-section="product-template" class="product-detail">
         <div class="product-detail__container">
            <div class="product-detail__inner">
               <div class="product-detail__gallery">
                  <ProductGallery
                     images={[
                        { src: Image, alt: "Photo 1" },
                        { src: Image, alt: "Photo 2" },
                        { src: Image, alt: "Photo 3" },
                        { src: Image, alt: "Photo 4" },
                        { src: Image, alt: "Photo 5" },
                     ]}
                     thumbsPosition="bottom"
                     maxVisible={4}
                     fancybox={true}
                     thumbScale={true}
                     thumbArrows={true}
                  />
               </div>

               <div class="product-detail__info" sf-product-info>
                  <div id="product-variants-json" sf-product-variants-json hidden>[]</div>
                  <div id="product-gallery-data" sf-product-gallery-data hidden></div>

                  <h1 class="product-detail__title" sf-product="title" sf-product-block="title">
                     One Life Graphic T-Shirt
                  </h1>

                  <div class="product-detail__price-wrap" sf-product-block="price">
                     <span class="product-detail__price" sf-product="price" data-money-format="">$260</span>
                     <span class="product-detail__price-old" sf-product="compare_price">$300</span>
                     <span class="product-detail__discount" sf-product="discount_badge">-13%</span>
                  </div>

                  <div class="product-detail__short-desc" sf-product="short_description" sf-product-block="short_description">
                     A premium quality t-shirt crafted from soft, breathable cotton.
                  </div>

                  <div class="product-detail__variants" sf-product-variants sf-product-block="variants"></div>

                  <div sf-product-block="form">
                     <form class="product-detail__form" sf-product-form>
                        <div class="product-detail__qty">
                           <button type="button" class="product-detail__qty-btn" data-qty-minus>−</button>
                           <input type="number" name="quantity" value="1" min="1" class="product-detail__qty-input" />
                           <button type="button" class="product-detail__qty-btn" data-qty-plus>+</button>
                        </div>
                        <button class="product-detail__btn btn" sf-product-btn>Add to Cart</button>
                     </form>
                  </div>

                  <div class="product-detail__sku" sf-product="sku" sf-product-block="sku">
                     <span class="product-detail__sku-label">SKU:</span>
                     <span class="product-detail__sku-value">ABC-123</span>
                  </div>

                  <div class="product-detail__payment" sf-product-payment-icons sf-product-block="payment">
                     <span class="product-detail__payment-label">We accept:</span>
                     <div class="product-detail__payment-icons"></div>
                  </div>

                  <div class="product-detail__delivery" sf-product-delivery sf-product-block="delivery">
                     🚚 Free shipping on orders over $50
                  </div>
               </div>
            </div>
         </div>
      </section>

      <section sf-section="product-tabs" class="product-tabs">
         <div class="product-tabs__container">
            <Tabs animation="fade" scrollable={true} indicator={true}>
               <Fragment slot="buttons">
                  <button class="tabs__button" data-tab="tab-desc" sf-product-tab-btn="description">Description</button>
                  <button class="tabs__button" data-tab="tab-specs" sf-product-tab-btn="specs">Details</button>
                  <button class="tabs__button" data-tab="tab-shipping" sf-product-tab-btn="shipping">Shipping &amp; Returns</button>
               </Fragment>
               <Fragment slot="panels">
                  <div class="tabs__panel" data-tab-content="tab-desc">
                     <h3 class="product-tabs__stacked-title" sf-product-tab-title="description">Description</h3>
                     <div class="product-tabs__content" sf-product="description">Full product description.</div>
                  </div>
                  <div class="tabs__panel" data-tab-content="tab-specs" sf-product-tab="specs">
                     <h3 class="product-tabs__stacked-title" sf-product-tab-title="specs">Details</h3>
                     <div class="product-tabs__content" sf-product="specs">Product details and specifications.</div>
                  </div>
                  <div class="tabs__panel" data-tab-content="tab-shipping" sf-product-tab="shipping">
                     <h3 class="product-tabs__stacked-title" sf-product-tab-title="shipping">Shipping &amp; Returns</h3>
                     <div class="product-tabs__content" sf-product-shipping-text>Shipping information.</div>
                  </div>
               </Fragment>
            </Tabs>
         </div>
      </section>
   </PageMain>
</BaseLayout>
