                  src={Image}
                  alt="My image"
                  wrapperClass="collection__item"
               />
               <MyImages
                  sf-image="hero_image"
                  src={Image2}
                  alt="My image"
                  wrapperClass="collection__item"
               />
               <MyImages
                  sf-image="hero_image"
                  src={Image}
                  alt="My image"
                  wrapperClass="collection__item"
               />
               <MyImages
