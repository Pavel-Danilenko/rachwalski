                  src={Image}
                  alt="My image"
                  wrapperClass="collection__item"
               />
               <MyImages
                  sf-image="hero_image"
                  src={Image2}
                  alt="My image"
                  wrapperClass="collection__item"
               />
            </Pagination>
         </div>
         <section sf-section="tabs" class="tabs">
            <div class="tabs__container">
               <Tabs sfTabs="services">
                  <Fragment slot="buttons">
                     <button data-tab="tab1" class="tabs__button">
                        Перший таб
                     </button>
                  </Fragment>
                  <Fragment slot="panels">
                     <div data-tab-content="tab1" class="tabs__panel">
                        <h3 sf-id="title">Заголовок</h3>
                        <div sf-id="text" sf-type="richtext">Текст...</div>
                        <Gallery sfGallery="gallery" collectionName="gallery" />
                        <MyImages
                           sf-image="hero_image"
                           src={Image}
                           alt="My image"
                        />
                     </div>
                  </Fragment>
               </Tabs>
            </div>
         </section>
      </section>
   </PageMain>
</BaseLayout>
