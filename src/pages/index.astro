               src={introPoster}
               alt=""
               formats={["avif", "webp", "png"]}
               widths={[768, 1280, 1920]}
               sizes="100vw"
               loading="eager"
               fetchpriority="high"
               class="video-banner__poster-img video-banner__poster-img--desktop"
            />
            <Picture
               src={introPosterMobile}
               alt=""
               formats={["avif", "webp", "png"]}
               widths={[390, 768, 1200]}
               sizes="100vw"
               loading="eager"
               fetchpriority="high"
               class="video-banner__poster-img video-banner__poster-img--mobile"
